// -------------------------------------------------------------------------- //
// ------------------------------ Decode Funcs ------------------------------ //
// -------------------------------------------------------------------------- //

// normalizer of x vector using vertical (Y) all-reduce communication
fn rmsnorm_x() void {
    @load_to_dsr(dest_dsr_1, X_tmp_dsd);
    @load_to_dsr(src0_dsr_1, X_dsd);
    @load_to_dsr(src1_dsr_1, X_dsd);
    @fmulh(dest_dsr_1, src0_dsr_1, src1_dsr_1);

    // ROW_WISE_REDUCE: [FIX: The output is unstable and depends on the compiler's register allocation]
    // dim_p_pe_dsd_1 = @set_dsd_base_addr(dim_p_pe_dsd_1, ptr_X_tmp);
    // @load_to_dsr(src1_dsr_1, dim_p_pe_dsd_1, .{ .save_address = true });
    // for (@range(i16, bsz)) |b| {    // FIX: The output is unstable and depends on the compiler's register allocation
    //     sum = 0.0;
    //     @faddh(ptr_sum, sum, src1_dsr_1);
    //     local_sum[b] = sum;
    // }
    @load_to_dsr(src0_dsr_1, local_sum_element_dsd, .{ .save_address = false });
    @load_to_dsr(src1_dsr_1, size1_chunk_dsd, .{ .save_address = true });
    @set_dsr_base_addr(src1_dsr_1, ptr_X_tmp);
    for (@range(i16, bsz)) |b| {
        @set_dsr_base_addr(src0_dsr_1, @ptrcast([*]f16, &local_sum[b]));
        @fmulh(src0_dsr_1, src0_dsr_1, 0.0);
        for (@range(i16, v_dim_p_pe)) |i| {
            @faddh(src0_dsr_1, src0_dsr_1, src1_dsr_1);
        }
    }

    // simprint.fmt_with_coords("print: all_reduce_without_reset rmsnorm_x\n", .{});

    comm_mod.all_reduce_without_reset(bsz, ptr_local_sum, comm_mod.comm_axis.vertical, false);     // vertical all-reduce of (bsz)

    // simprint.fmt_with_coords("print: all_reduce_without_reset rmsnorm_x end normalization\n", .{});

    v_dim_p_pe_dsd_1 = @set_dsd_base_addr(v_dim_p_pe_dsd_1, ptr_X_norm);
    v_dim_p_pe_dsd_2 = @set_dsd_base_addr(v_dim_p_pe_dsd_2, ptr_X);     // FIX: replace ptr_X_tmp to ptr_X
    @load_to_dsr(dest_dsr_1, v_dim_p_pe_dsd_1, .{ .save_address = true});
    @load_to_dsr(src0_dsr_1, v_dim_p_pe_dsd_2, .{ .save_address = true});
    @load_to_dsr(src1_dsr_1, W_dsd, .{ .save_address = false});
    for (@range(i16, bsz)) |b| {
        @fmulh(dest_dsr_1, src0_dsr_1, src1_dsr_1);
    }

    v_dim_p_pe_dsd_1 = @set_dsd_base_addr(v_dim_p_pe_dsd_1, ptr_X_norm);
    @load_to_dsr(dest_dsr_1, v_dim_p_pe_dsd_1, .{ .save_address = true});
    @load_to_dsr(src0_dsr_1, v_dim_p_pe_dsd_1, .{ .save_address = true});
    @map(fmulh_norm_func, local_sum_dsd);
}

// query vector generator
fn xq_matvec_mult() void {
    @load_to_dsr(dest_dsr_1, Q_dsd);
    @fmovh(dest_dsr_1, 0.0);

    left_vector_dsd = @set_dsd_base_addr(left_vector_dsd, ptr_X_norm);

    ptr_right_matrix = &Q_weight_tile;

    // out_vector_dsd = @set_dsd_base_addr(out_vector_dsd, ptr_Q);
    out_vector_dsd = @set_dsd_base_addr(out_vector_dsd, ptr_QKV_tile);

    Kt = v_dim_p_pe;
    Nt = h_dim_p_pe;

    vecmat_computation();

    // comm_mod.all_reduce_bsz_dim(py, quotient_y, remainder_y, ptr_Q);
}

// key vector generator
fn xk_matvec_mult() void {
    @load_to_dsr(dest_dsr_1, K_dsd);
    @fmovh(dest_dsr_1, 0.0);

    left_vector_dsd = @set_dsd_base_addr(left_vector_dsd, ptr_X_norm);

    ptr_right_matrix = &K_weight_tile;

    // out_vector_dsd = @set_dsd_base_addr(out_vector_dsd, ptr_K);
    out_vector_dsd = @set_dsd_base_addr(out_vector_dsd, ptr_QKV_tile);
    out_vector_dsd = @increment_dsd_offset(out_vector_dsd, bsz*h_dim_p_pe, f16);

    Kt = v_dim_p_pe;
    Nt = h_dim_p_pe;

    vecmat_computation();

    // comm_mod.all_reduce_bsz_dim(py, quotient_y, remainder_y, ptr_K);
}

// value vector generator
fn xv_matvec_mult() void {
    @load_to_dsr(dest_dsr_1, V_dsd);
    @fmovh(dest_dsr_1, 0.0);

    left_vector_dsd = @set_dsd_base_addr(left_vector_dsd, ptr_X_norm);

    ptr_right_matrix = &V_weight_tile;

    // out_vector_dsd = @set_dsd_base_addr(out_vector_dsd, ptr_V);
    out_vector_dsd = @set_dsd_base_addr(out_vector_dsd, ptr_QKV_tile);
    out_vector_dsd = @increment_dsd_offset(out_vector_dsd, 2*bsz*h_dim_p_pe, f16);

    Kt = v_dim_p_pe;
    Nt = h_dim_p_pe;

    vecmat_computation();

    // comm_mod.all_reduce_bsz_dim(py, quotient_y, remainder_y, ptr_V);
}

// query rottery positional encoding (local)
fn xq_rope() void {
    X_even_dsd = @set_dsd_base_addr(X_even_dsd, ptr_QKV_tile);
    X_odd_dsd = @set_dsd_base_addr(X_odd_dsd, @ptrcast([*]f16, &ptr_QKV_tile[1]));  // FIX: set_dsd_base_addr updates base_addr + offset

    @load_to_dsr(dest_dsr_1, X_tmp_1_dsd);
    @load_to_dsr(dest_dsr_2, X_tmp_2_dsd);

    @load_to_dsr(src1_dsr_1, freqs_cos_dsd);
    @load_to_dsr(src1_dsr_2, freqs_sin_dsd);

    @load_to_dsr(src0_dsr_3, X_tmp_1_dsd);
    @load_to_dsr(src1_dsr_3, X_tmp_2_dsd);

    @load_to_dsr(src0_dsr_1, X_odd_dsd, .{ .save_address = true });
    @load_to_dsr(src0_dsr_2, X_even_dsd, .{ .save_address = true });
    @load_to_dsr(dest_dsr_3, X_odd_dsd, .{ .save_address = true });
    @load_to_dsr(dest_dsr_4, X_even_dsd, .{ .save_address = true });

    for (@range(i16, bsz)) |b| {

        @fmulh(dest_dsr_1, src0_dsr_1, src1_dsr_1);
        @fmulh(dest_dsr_2, src0_dsr_2, src1_dsr_2);
        @fsubh(dest_dsr_4, src0_dsr_3, src1_dsr_3);

        @fmulh(dest_dsr_1, src0_dsr_2, src1_dsr_1);
        @fmulh(dest_dsr_2, src0_dsr_1, src1_dsr_2);
        @faddh(dest_dsr_3, src0_dsr_3, src1_dsr_3);

    }
}

// key rottery positional encoding (local)
fn xk_rope() void {
    X_even_dsd = @set_dsd_base_addr(X_even_dsd, ptr_QKV_tile);
    X_odd_dsd = @set_dsd_base_addr(X_odd_dsd, @ptrcast([*]f16, &ptr_QKV_tile[1]));
    X_even_dsd = @increment_dsd_offset(X_even_dsd, bsz*h_dim_p_pe, f16);
    X_odd_dsd = @increment_dsd_offset(X_odd_dsd, bsz*h_dim_p_pe, f16);

    @load_to_dsr(dest_dsr_1, X_tmp_1_dsd);
    @load_to_dsr(dest_dsr_2, X_tmp_2_dsd);

    @load_to_dsr(src1_dsr_1, freqs_cos_dsd);
    @load_to_dsr(src1_dsr_2, freqs_sin_dsd);

    @load_to_dsr(src0_dsr_3, X_tmp_1_dsd);
    @load_to_dsr(src1_dsr_3, X_tmp_2_dsd);

    @load_to_dsr(src0_dsr_1, X_odd_dsd, .{ .save_address = true });
    @load_to_dsr(src0_dsr_2, X_even_dsd, .{ .save_address = true });
    @load_to_dsr(dest_dsr_3, X_odd_dsd, .{ .save_address = true });
    @load_to_dsr(dest_dsr_4, X_even_dsd, .{ .save_address = true });

    for (@range(i16, bsz)) |b| {

        @fmulh(dest_dsr_1, src0_dsr_1, src1_dsr_1);
        @fmulh(dest_dsr_2, src0_dsr_2, src1_dsr_2);
        @fsubh(dest_dsr_4, src0_dsr_3, src1_dsr_3);

        @fmulh(dest_dsr_1, src0_dsr_2, src1_dsr_1);
        @fmulh(dest_dsr_2, src0_dsr_1, src1_dsr_2);
        @faddh(dest_dsr_3, src0_dsr_3, src1_dsr_3);

    }
}

fn score_matvec_mult() void {
    @load_to_dsr(dest_dsr_1, score_dsd);
    @fmovh(dest_dsr_1, 0.0);

    left_vector_dsd = @set_dsd_base_addr(left_vector_dsd, ptr_QKV_tile);
    
    ptr_right_matrix = &XKCache_tile;

    out_vector_dsd = @set_dsd_base_addr(out_vector_dsd, ptr_score);

    Kt = h_dim_p_pe;
    Nt = seq_len_p_pe;

    vecmat_computation();

    // simprint.fmt_with_coords("print: all_reduce_in_head start\n", .{});

    // AllReduce(s) are conducted on n_heads independent units of pes_p_head PEs
    comm_mod.all_reduce_with_reset(bsz * seq_len_p_pe, ptr_score, comm_mod.comm_axis.horizontal_in_head);

    // simprint.fmt_with_coords("print: all_reduce_in_head end\n", .{});

    // Apply score_mask: add -inf to padded seq positions so they vanish after softmax
    @load_to_dsr(src1_dsr_1, score_mask_dsd);
    @load_to_dsr(src0_dsr_1, score_batch_dsd, .{ .save_address = true });
    @load_to_dsr(dest_dsr_1, score_batch_dsd, .{ .save_address = true });
    for (@range(i16, bsz)) |b| {
        @faddh(dest_dsr_1, src0_dsr_1, src1_dsr_1);
    }

    // score factor
    @load_to_dsr(dest_dsr_1, score_dsd, .{ .save_address = false });
    @load_to_dsr(src0_dsr_1, score_dsd, .{ .save_address = false });
    @fmulh(dest_dsr_1, src0_dsr_1, alpha);
}

fn softmax_score() void {

    // ROW_WISE_REDUCE: [FIX: The output is unstable and depends on the compiler's register allocation]
    // seq_len_p_pe_dsd_1 = @set_dsd_base_addr(seq_len_p_pe_dsd_1, ptr_score);
    // @load_to_dsr(src1_dsr_1, seq_len_p_pe_dsd_1, .{ .save_address = true });
    // for (@range(i16, bsz)) |b| {    // FIX: unstable if bsz > 1
    //     max = 0.0;
    //     @fmaxh(ptr_max, max, src1_dsr_1);   // FIX: dest and src0 must be assigned to the same reg, but it is not guaranteed now 
    //     local_max[b] = max;
    // }
    @load_to_dsr(src0_dsr_1, local_max_element_dsd, .{ .save_address = false });
    @load_to_dsr(src1_dsr_1, size1_chunk_dsd, .{ .save_address = true });
    @set_dsr_base_addr(src1_dsr_1, ptr_score);
    for (@range(i16, bsz)) |b| {
        @set_dsr_base_addr(src0_dsr_1, @ptrcast([*]f16, &local_max[b]));
        @faddh(src0_dsr_1, src0_dsr_1, math.NEGATIVE_INF_f16);
        for (@range(i16, seq_len_p_pe)) |i| {
            @fmaxh(src0_dsr_1, src0_dsr_1, src1_dsr_1);
        }
    }

    // simprint.fmt_with_coords("print: all_reduce_without_reset max softmax_score\n", .{});

    comm_mod.all_reduce_without_reset(bsz, ptr_local_max, comm_mod.comm_axis.vertical, true);     // vertical all-reduce of (bsz)

    // simprint.fmt_with_coords("print: all_reduce_without_reset max softmax_score end\n", .{});

    seq_len_p_pe_dsd_1 = @set_dsd_base_addr(seq_len_p_pe_dsd_1, ptr_score_tmp);
    seq_len_p_pe_dsd_2 = @set_dsd_base_addr(seq_len_p_pe_dsd_2, ptr_score);
    @load_to_dsr(dest_dsr_1, seq_len_p_pe_dsd_1, .{ .save_address = true });
    @load_to_dsr(src0_dsr_1, seq_len_p_pe_dsd_2, .{ .save_address = true });
    @map(fsubh_func, local_max_dsd);

    // simprint.fmt_with_coords("print: exp_naive softmax_score \n", .{});

    // @map(fast_exp, score_tmp_dsd, score_dsd);
    // @map(math.exp_f16, score_tmp_dsd, score_dsd);
    // for (@range(i16, bsz*seq_len_p_pe)) |i| {
    //     score[i] = fast_exp(score_tmp[i]);
    // }
    vectorized_exp_f16(bsz*seq_len_p_pe, ptr_score_tmp, ptr_score);

    // simprint.fmt_with_coords("print: row_wise_sum_reduce softmax_score \n", .{});

    // ROW_WISE_REDUCE: [FIX: The output is unstable and depends on the compiler's register allocation]
    // seq_len_p_pe_dsd_1 = @set_dsd_base_addr(seq_len_p_pe_dsd_1, ptr_score);
    // @load_to_dsr(src1_dsr_1, seq_len_p_pe_dsd_1, .{ .save_address = true });
    // for (@range(i16, bsz)) |b| {    // FIX: unstable if bsz > 1
    //     sum = 0.0;
    //     @faddh(ptr_sum, sum, src1_dsr_1);
    //     local_sum[b] = sum;
    // }
    @load_to_dsr(src0_dsr_1, local_sum_element_dsd, .{ .save_address = false });
    @load_to_dsr(src1_dsr_1, size1_chunk_dsd, .{ .save_address = true });
    @set_dsr_base_addr(src1_dsr_1, ptr_score);
    for (@range(i16, bsz)) |b| {
        @set_dsr_base_addr(src0_dsr_1, @ptrcast([*]f16, &local_sum[b]));
        @fmulh(src0_dsr_1, src0_dsr_1, 0.0);
        for (@range(i16, seq_len_p_pe)) |i| {
            @faddh(src0_dsr_1, src0_dsr_1, src1_dsr_1);
        }
    }

    // simprint.fmt_with_coords("print: all_reduce_without_reset sum softmax_score\n", .{});

    comm_mod.all_reduce_without_reset(bsz, ptr_local_sum, comm_mod.comm_axis.vertical, false);     // vertical all-reduce of (bsz)

    // simprint.fmt_with_coords("print: all_reduce_without_reset sum softmax_score end fmulh_softmax_func\n", .{});

    seq_len_p_pe_dsd_1 = @set_dsd_base_addr(seq_len_p_pe_dsd_1, ptr_score);
    @load_to_dsr(dest_dsr_1, seq_len_p_pe_dsd_1, .{ .save_address = true });
    @load_to_dsr(src0_dsr_1, seq_len_p_pe_dsd_1, .{ .save_address = true });
    @map(fmulh_softmax_func, local_sum_dsd);

    // softmax result of padded seq positions are -inf (normally non-negative), which must be masked as 0 using fmaxh
    @load_to_dsr(dest_dsr_1, score_dsd);
    @load_to_dsr(src0_dsr_1, score_dsd);
    @fmaxh(dest_dsr_1, src0_dsr_1, 0.0);
}

fn output_matvec_mult() void {
    @load_to_dsr(dest_dsr_1, output_dsd);
    @fmovh(dest_dsr_1, 0.0);

    left_vector_dsd = @set_dsd_base_addr(left_vector_dsd, ptr_score);
    
    ptr_right_matrix = &XVCache_tile;

    out_vector_dsd = @set_dsd_base_addr(out_vector_dsd, ptr_output);

    Kt = seq_len_p_pe;
    Nt = h_dim_p_pe;

    vecmat_computation();

    // simprint.fmt_with_coords("print: all_reduce_with_reset output_matvec_mult\n", .{});

    comm_mod.all_reduce_with_reset(bsz * h_dim_p_pe, ptr_output, comm_mod.comm_axis.vertical);      // vertical all-reduce of (bsz, h_dim_p_pe)
}

fn o_matvec_mult() void {
    @load_to_dsr(dest_dsr_1, h1_dsd);
    @fmovh(dest_dsr_1, 0.0);

    left_vector_dsd = @set_dsd_base_addr(left_vector_dsd, ptr_output);
    
    ptr_right_matrix = &O_weight_tile;

    out_vector_dsd = @set_dsd_base_addr(out_vector_dsd, ptr_h1);

    Kt = h_dim_p_pe;
    Nt = v_dim_p_pe;

    vecmat_computation();

    // simprint.fmt_with_coords("print: all_reduce_with_reset o_matvec_mult\n", .{});

    comm_mod.all_reduce_with_reset(bsz * v_dim_p_pe, ptr_h1, comm_mod.comm_axis.horizontal);    // horizontal all-reduce of (bsz, v_dim_p_pe)
}

fn attn_residual_add() void {
    @load_to_dsr(dest_dsr_1, Z_dsd);
    @load_to_dsr(src0_dsr_1, X_dsd);
    @load_to_dsr(src1_dsr_1, h1_dsd);
    @faddh(dest_dsr_1, src0_dsr_1, src1_dsr_1);
}

fn rmsnorm_z() void {
    @load_to_dsr(dest_dsr_1, X_tmp_dsd);
    @load_to_dsr(src0_dsr_1, Z_dsd);
    @load_to_dsr(src1_dsr_1, Z_dsd);
    @fmulh(dest_dsr_1, src0_dsr_1, src1_dsr_1);
    
    // ROW_WISE_REDUCE: [FIX: The output is unstable and depends on the compiler's register allocation]
    // dim_p_pe_dsd_1 = @set_dsd_base_addr(dim_p_pe_dsd_1, ptr_X_tmp);
    // @load_to_dsr(src1_dsr_1, dim_p_pe_dsd_1, .{ .save_address = true });
    // for (@range(i16, bsz)) |b| {    // FIX: unstable if bsz > 1
    //     sum = 0.0;
    //     @faddh(ptr_sum, sum, src1_dsr_1);
    //     local_sum[b] = sum;
    // }
    @load_to_dsr(src0_dsr_1, local_sum_element_dsd, .{ .save_address = false });
    @load_to_dsr(src1_dsr_1, size1_chunk_dsd, .{ .save_address = true });
    @set_dsr_base_addr(src1_dsr_1, ptr_X_tmp);
    for (@range(i16, bsz)) |b| {
        @set_dsr_base_addr(src0_dsr_1, @ptrcast([*]f16, &local_sum[b]));
        @fmulh(src0_dsr_1, src0_dsr_1, 0.0);
        for (@range(i16, v_dim_p_pe)) |i| {
            @faddh(src0_dsr_1, src0_dsr_1, src1_dsr_1);
        }
    }

    // simprint.fmt_with_coords("print: all_reduce_without_reset rmsnorm_z\n", .{});

    comm_mod.all_reduce_without_reset(bsz, ptr_local_sum, comm_mod.comm_axis.vertical, false);     // vertical all-reduce of (bsz)

    // simprint.fmt_with_coords("print: all_reduce_without_reset rmsnorm_z end normalization\n", .{});

    v_dim_p_pe_dsd_1 = @set_dsd_base_addr(v_dim_p_pe_dsd_1, ptr_z_norm);
    v_dim_p_pe_dsd_2 = @set_dsd_base_addr(v_dim_p_pe_dsd_2, ptr_Z);     // FIX: replace ptr_X_tmp to ptr_Z
    @load_to_dsr(dest_dsr_1, v_dim_p_pe_dsd_1, .{ .save_address = true });
    @load_to_dsr(src0_dsr_1, v_dim_p_pe_dsd_2, .{ .save_address = true });
    @load_to_dsr(src1_dsr_1, W_dsd, .{ .save_address = false });
    for (@range(i16, bsz)) |b| {
        @fmulh(dest_dsr_1, src0_dsr_1, src1_dsr_1);
    }

    v_dim_p_pe_dsd_1 = @set_dsd_base_addr(v_dim_p_pe_dsd_1, ptr_z_norm);
    @load_to_dsr(dest_dsr_1, v_dim_p_pe_dsd_1, .{ .save_address = true });
    @load_to_dsr(src0_dsr_1, v_dim_p_pe_dsd_1, .{ .save_address = true });
    @map(fmulh_norm_func, local_sum_dsd);
}

fn up_matvec_mult() void {
    @load_to_dsr(dest_dsr_1, z1_dsd);
    @fmovh(dest_dsr_1, 0.0);

    left_vector_dsd = @set_dsd_base_addr(left_vector_dsd, ptr_z_norm);
    
    ptr_right_matrix = &UP_weight_tile;

    // out_vector_dsd = @set_dsd_base_addr(out_vector_dsd, ptr_z1);
    out_vector_dsd = @set_dsd_base_addr(out_vector_dsd, ptr_ZZ_tile);

    Kt = v_dim_p_pe;
    Nt = ffn_dim_p_pe;

    vecmat_computation();

    // comm_mod.all_reduce_bsz_ffn_dim(py, quotient_y, remainder_y, ptr_z1);
}

fn gate_matvec_mult() void {
    @load_to_dsr(dest_dsr_1, z2_dsd);
    @fmovh(dest_dsr_1, 0.0);

    left_vector_dsd = @set_dsd_base_addr(left_vector_dsd, ptr_z_norm);
    
    ptr_right_matrix = &GATE_weight_tile;

    // out_vector_dsd = @set_dsd_base_addr(out_vector_dsd, ptr_z2);
    out_vector_dsd = @set_dsd_base_addr(out_vector_dsd, ptr_ZZ_tile);
    out_vector_dsd = @increment_dsd_offset(out_vector_dsd, bsz * ffn_dim_p_pe, f16);

    Kt = v_dim_p_pe;
    Nt = ffn_dim_p_pe;

    vecmat_computation();

    // comm_mod.all_reduce_bsz_ffn_dim(py, quotient_y, remainder_y, ptr_z2);
}

// fn silu_kernel(val: f16) f16 {
//     return val / (1.0 + fast_exp(-val));
// }

var z2_val: f16 = 0.0;
fn z2_silu() void {
    // for (@range(i16, bsz*ffn_dim_p_pe, 2*bsz*ffn_dim_p_pe, 1)) |i| {   // FIX: @range(i16, bsz*dim_p_pe) should be @range(i16, bsz*ffn_dim_p_pe, 2*bsz*ffn_dim_p_pe, 1)
    //     z2_val = ZZ_tile[i];
    //     // ZZ_tile[i] = z2_val / (1.0 + fast_exp(-z2_val));
    //     ZZ_tile[i] = z2_val / (1.0 + math.exp_f16(-z2_val));
    // }
    // @map(silu_kernel, z2_dsd, z2_dsd);

    // simprint.fmt_with_coords("print: z2[0] = {f}\n", .{@as(@fp16(),ZZ_tile[bsz * ffn_dim_p_pe])});
    @load_to_dsr(dest_dsr_4, z2_tmp_dsd);
    @load_to_dsr(src0_dsr_4, z2_tmp_dsd);
    @load_to_dsr(src1_dsr_4, z2_dsd);
    @fnegh(dest_dsr_4, src1_dsr_4);
    vectorized_exp_f16(bsz*ffn_dim_p_pe, ptr_z2_tmp, ptr_z3);
    @set_dsr_base_addr(dest_dsr_4, ptr_z3);
    @set_dsr_base_addr(src0_dsr_4, ptr_z3);
    @faddh(dest_dsr_4, src0_dsr_4, @as(f16, 1.0));
    vectorized_reciprocal_f16(bsz*ffn_dim_p_pe, ptr_z3, ptr_z2_tmp);
    @set_dsr_base_addr(dest_dsr_4, @ptrcast([*]f16, &ZZ_tile[bsz*ffn_dim_p_pe]));
    @set_dsr_base_addr(src0_dsr_4, ptr_z2_tmp);
    @fmulh(dest_dsr_4, src0_dsr_4, src1_dsr_4);
    // simprint.fmt_with_coords("print: z2[0] = {f}\n", .{@as(@fp16(),ZZ_tile[bsz * ffn_dim_p_pe])});
}

fn z3_mat() void {
    @load_to_dsr(dest_dsr_1, z3_dsd);
    @load_to_dsr(src0_dsr_1, z1_dsd);
    @load_to_dsr(src1_dsr_1, z2_dsd);
    @fmulh(dest_dsr_1, src0_dsr_1, src1_dsr_1);
}

fn down_matvec_mult() void {
    @load_to_dsr(dest_dsr_1, h2_dsd);
    @fmovh(dest_dsr_1, 0.0);

    left_vector_dsd = @set_dsd_base_addr(left_vector_dsd, ptr_z3);
    
    ptr_right_matrix = &DOWN_weight_tile;

    out_vector_dsd = @set_dsd_base_addr(out_vector_dsd, ptr_h2);

    Kt = ffn_dim_p_pe;
    Nt = v_dim_p_pe;

    vecmat_computation();

    // simprint.fmt_with_coords("print: all_reduce_with_reset down_matvec_mult\n", .{});

    comm_mod.all_reduce_with_reset(bsz * v_dim_p_pe, ptr_h2, comm_mod.comm_axis.horizontal);    // horizontal all-reduce of (bsz, v_dim_p_pe)
}

fn ffn_residual_add() void {
    @load_to_dsr(dest_dsr_1, Z_dsd);
    @load_to_dsr(src0_dsr_1, Z_dsd);
    @load_to_dsr(src1_dsr_1, h2_dsd);
    @faddh(dest_dsr_1, src0_dsr_1, src1_dsr_1);
}

fn decode_struct() void {
    // load fabric dsd(s) to dsr
    // simprint.fmt_with_coords("print: runtime_setup\n", .{});

    comm_mod.runtime_setup();

    // normalize x: 1. local sum(x^2), 2. vertical all-reduce 3. local x / sqrt(s/D + eps)
    // simprint.fmt_with_coords("print: square_sum rmsnorm_x\n", .{});

    rmsnorm_x();

    // simprint.fmt_with_coords("print: qkv_matvec_mult\n", .{});

    // normalized x to q, k, v vector: 1. local GEMV, 2. fused vertical all-reduce
    xq_matvec_mult();
    xk_matvec_mult();
    xv_matvec_mult();

    // simprint.fmt_with_coords("print: all_reduce_QKV_fusion\n", .{});

    comm_mod.all_reduce_with_reset(bsz * 3 * h_dim_p_pe, ptr_QKV_tile, comm_mod.comm_axis.vertical);    // vertical all-reduce of (bsz, 3*h_dim_p_pe)

    // simprint.fmt_with_coords("print: all_reduce_QKV_fusion end, reconfig\n", .{});

    comm_mod.reconfig_allreduce_axis(0, true); // 0: px row-wise, 1: py col-wise, is_in_head is true

    // simprint.fmt_with_coords("print: RoPE\n", .{});

    // positional encoding
    xq_rope();
    xk_rope();

    // simprint.fmt_with_coords("print: score_matvec_mult\n", .{});

    // s_new = q_new @ K_cache: 1. local GEMV, 2. horizontal all-reduce
    score_matvec_mult();

    // simprint.fmt_with_coords("print: reconfig\n", .{});

    comm_mod.reconfig_allreduce_axis(1, false);

    // simprint.fmt_with_coords("print: softmax_score\n", .{});

    // score_new = softmax(s_new): 1. local MAX, 2. vertical all-reduce, 3. local sum(exp), 4. vertical all-reduce
    softmax_score();

    // simprint.fmt_with_coords("print: output_matvec_mult\n", .{});

    // output_new = score_new @ V_cache: 1. local GEMV, 2. vertical all-reduce
    output_matvec_mult();

    // simprint.fmt_with_coords("print: reconfig\n", .{});

    comm_mod.reconfig_allreduce_axis(0, false);

    // simprint.fmt_with_coords("print: o_matvec_mult\n", .{});

    // h1 = output_new @ O_weight: 1. local GEMV, 2. horizontal all-reduce
    o_matvec_mult();

    // simprint.fmt_with_coords("print: attn_residual_add\n", .{});

    // local residual connection (adding input x to h1) to generate z
    attn_residual_add();

    // simprint.fmt_with_coords("print: reconfig\n", .{});

    comm_mod.reconfig_allreduce_axis(1, false);

    // normalization of output z from attention heads (post-norm fashion): 1. local sum(z^2), 
    // simprint.fmt_with_coords("print: square_sum rmsnorm_z\n", .{});

    rmsnorm_z();

    // SwiGLU (Gated Linear Unit): 
    //  1. up matvec (local) to generate z1
    //  2. gate matvec (local) to generate z2
    //  3. fused vertical all-reduce
    // simprint.fmt_with_coords("print: up_matvec_mult\n", .{});
    up_matvec_mult();
    // simprint.fmt_with_coords("print: gate_matvec_mult\n", .{});
    gate_matvec_mult();
    // simprint.fmt_with_coords("print: all_reduce_ZZ_fusion\n", .{});
    comm_mod.all_reduce_with_reset(bsz * 2 * ffn_dim_p_pe, ptr_ZZ_tile, comm_mod.comm_axis.vertical);   // vertical all-reduce of (bsz, 2*ffn_dim_p_pe)

    //  4. activate gated vector z2
    // simprint.fmt_with_coords("print: SiLU\n", .{});

    z2_silu();

    //  5. element-wise multiplication between z1 and z2
    // simprint.fmt_with_coords("print: Z3_mat\n", .{});

    z3_mat();

    // simprint.fmt_with_coords("print: reconfig\n", .{});

    comm_mod.reconfig_allreduce_axis(0, false);

    //  6. down matvec h2 = z3 @ W_down : 1. local GEMV, 2. horizontal all-reduce
    // simprint.fmt_with_coords("print: down_matvec_mult\n", .{});

    down_matvec_mult();

    // residual connection h2 = z + h2
    // simprint.fmt_with_coords("print: ffn_residual_add\n", .{});

    ffn_residual_add();

    // simprint.fmt_with_coords("print: reconfig\n", .{});

    comm_mod.reconfig_allreduce_axis(1, false);

    // decode_entry();
}

fn exit() void {
    timestamp.get_timestamp(&tsc_end_buf);
    timestamp.disable_tsc();

    // f_reference_timestamps();
    f_memcpy_timestamps();
    sys_mod.unblock_cmd_stream();
}


// -------------------------------------------------------------------------- //
// ------------------------------ Entry Point ----------------------------- //
// -------------------------------------------------------------------------- //
var total_repeat_times: i16 = 1;
var total_warmup_times: i16 = 0;
var repeat_times: i16 = 0; // Start from 0

fn decode_host(total_warmup_times_: i16, total_repeat_times_: i16) void {
    total_warmup_times = total_warmup_times_;
    total_repeat_times = total_repeat_times_;
    repeat_times = 0;

    // timestamp.enable_tsc();
    // timestamp.get_timestamp(&tsc_ref_buf);
    sync.start();   // @activate(decode_entry_task_id); is called inside

    // decode_entry();
    timestamp.enable_tsc();
}

// fn decode_entry() void {
task decode_entry() void {
    // Run (total_warmup_times + total_repeat_times) times; only the last `total_repeat_times` iterations are timed
    if (repeat_times == total_warmup_times) {
        timestamp.reset_tsc_counter(); // start from 0
        timestamp.get_timestamp(&tsc_start_buf);
    }

    repeat_times += 1;
    decode_struct();
    if (repeat_times == total_warmup_times + total_repeat_times) {
        exit();
    } else {
        @activate(decode_entry_task_id);
    }
}


