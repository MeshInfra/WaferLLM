param memcpy_params;

// -------------------------------------------------------------------------- //
// ---------------------------- Model Parameters ---------------------------- //
// -------------------------------------------------------------------------- //

param Pw: i16;
param Ph: i16;
param bsz: i16;
param h_dim_p_pe: i16;
param v_dim_p_pe: i16;
param seq_len_p_pe: i16;
param ffn_dim_p_pe: i16;

const _dim_p_pe: i16 = (h_dim_p_pe / 2) * 2;

param pes_p_head: i16;
param pes_p_kv_head: i16;   // not used now
param head_dim: i16;

param pe_num_p_h_group: i16;
param pe_num_p_v_group: i16;
param pe_num_p_group_in_head: i16;

param pe_num_p_last_h_group: i16;
param pe_num_p_last_v_group: i16;
param pe_num_p_last_group_in_head: i16;

param C_1st_RD_0: color;
param C_1st_RD_1: color;
param C_2nd_RD_0: color;
param C_2nd_RD_1: color;
param C_BD: color;

param is_first_row: bool;
param is_first_col: bool;
param is_last_row: bool;
param is_last_col: bool;

const trace = @import_module(
  "<debug>",
  .{ .key = "debug_main",
     .buffer_size = 100,
   }
);
const simprint = @import_module("<simprint>");

const h_group_num: i16 = Pw / pe_num_p_h_group;
const v_group_num: i16 = Ph / pe_num_p_v_group;
const group_num_in_head: i16 = pes_p_head / pe_num_p_group_in_head;

const h_remainder: i16 = Pw - h_group_num * pe_num_p_h_group;
const v_remainder: i16 = Ph - v_group_num * pe_num_p_v_group;
const head_remainder: i16 = pes_p_head - group_num_in_head * pe_num_p_group_in_head;

const _root_px_1st_phase = pe_num_p_h_group / 2;
const _root_px_2nd_phase = (h_group_num / 2) * pe_num_p_h_group + _root_px_1st_phase;
const _root_py_1st_phase = pe_num_p_v_group / 2;
const _root_py_2nd_phase = (v_group_num / 2) * pe_num_p_v_group + _root_py_1st_phase;

const _root_px_in_head_1st_phase: i16 = pe_num_p_group_in_head / 2;
const _root_px_in_head_2nd_phase: i16 = (group_num_in_head / 2) * pe_num_p_group_in_head + _root_px_in_head_1st_phase;

// -------------------------------------------------------------------------- //
// -------------------------------- Task IDs -------------------------------- //
// -------------------------------------------------------------------------- //

const decode_entry_task_id: local_task_id = @get_local_task_id(17);

// -------------------------------------------------------------------------- //
// ------------------------------ PE Variables ------------------------------ //
// -------------------------------------------------------------------------- //

var px: i16 = 0;
var py: i16 = 0;

var quotient_x: i16 = 0;
var remainder_x: i16 = 0;
var quotient_y: i16 = 0;
var remainder_y: i16 = 0;

var head_idx: i16 = 0;
var px_in_head: i16 = 0;
var quotient_x_in_head: i16 = 0;
var remainder_x_in_head: i16 = 0;

const _head_dim: f16 = @as(f16, head_dim);
const dim: f16 = @as(f16, (Pw / pes_p_head) * head_dim);

const eps: f16 = 0.000001;
var alpha: f16 = 0.0;
var inv_dim: f16 = 0.0;

// -------------------------------------------------------------------------- //
// --------------------------- WSE3 Modules Parameters ---------------------- //
// -------------------------------------------------------------------------- //

const sys_mod = @import_module("<memcpy/memcpy>", memcpy_params);
const math = @import_module("<math>");
const layout_mod = @import_module("<layout>");

// const comm_mod = @import_module("comm_lib/comm_pe.csl", @concat_structs(comm_params, .{ 
const comm_mod = @import_module("comm_lib/comm_pe.csl", .{ 
    .Pw = Pw, .Ph = Ph, 

    // for multi-head attention
    .pes_p_head = pes_p_head,

    .pe_num_p_first_h_group = pe_num_p_h_group,
    .pe_num_p_first_v_group = pe_num_p_v_group,
    .pe_num_p_first_group_in_head = pe_num_p_group_in_head,
    .pe_num_p_last_h_group = pe_num_p_last_h_group,
    .pe_num_p_last_v_group = pe_num_p_last_v_group,
    .pe_num_p_last_group_in_head = pe_num_p_last_group_in_head,

    .reduce_1st_color_0 = C_1st_RD_0,
    .reduce_1st_color_1 = C_1st_RD_1,
    .reduce_2nd_color_0 = C_2nd_RD_0,
    .reduce_2nd_color_1 = C_2nd_RD_1,
    .broadcast_color = C_BD,
// }));
});

const sync = @import_module("sync.csl", .{
    .width = Pw,
    .height = Ph,
    .color_1 = @get_color(2),
    .actvt = decode_entry_task_id,
    .iq_1 = @get_input_queue(2), .oq_1 = @get_output_queue(2),
    .is_first_row = is_first_row,
    .is_first_col = is_first_col,
    .is_last_row = is_last_row,
    .is_last_col = is_last_col,
});

// -------------------------------------------------------------------------- //
// ------------------------------ Timer Module ------------------------------ //
// -------------------------------------------------------------------------- //

const timestamp = @import_module("<time>");

var tsc_end_buf = @zeros([timestamp.tsc_size_words]u16);
var tsc_start_buf = @zeros([timestamp.tsc_size_words]u16);

// var timer_buf = @zeros([3]f32);
// var ptr_timer_buf: [*]f32 = &timer_buf;

// var tsc_ref_buf = @zeros([timestamp.tsc_size_words]u16);
// var time_ref_f32 = @zeros([2]f32);
// var ptr_time_ref: [*]f32 = &time_ref_f32;

var time_buf_u16 = @zeros([timestamp.tsc_size_words*2]u16);  // 6要素 (start 3 + end 3)
var ptr_time_buf_u16: [*]u16 = &time_buf_u16;

// -------------------------------------------------------------------------- //
// --------------------------------- Utils ---------------------------------- //
// -------------------------------------------------------------------------- //

fn init_task() void {
    // timestamp.enable_tsc();

    px = @as(i16, layout_mod.get_x_coord());
    py = @as(i16, layout_mod.get_y_coord());

    // general attention block
    quotient_x = @as(i16, math.floor_f16(@as(f16, px) / @as(f16, pe_num_p_h_group)));   // group idx
    remainder_x = px - quotient_x * pe_num_p_h_group;   // local idx (in a group)

    quotient_y = @as(i16, math.floor_f16(@as(f16, py) / @as(f16, pe_num_p_v_group)));
    remainder_y = py - quotient_y * pe_num_p_v_group;

    // multi-head attention
    head_idx = @as(i16, math.floor_f16(@as(f16, px) / @as(f16, pes_p_head)));     // head idx
    px_in_head = px - head_idx * pes_p_head;     // local idx (in a head)
    quotient_x_in_head = @as(i16, math.floor_f16(@as(f16, px_in_head) / @as(f16, pe_num_p_group_in_head))); // group idx in a head
    remainder_x_in_head = px_in_head - quotient_x_in_head * pe_num_p_group_in_head; // local idx (in a group in a head)

    // effective values for comm_pe.csl (per-PE, may differ from global for fractional groups)
    const eff_pe_num_p_h_group: i16 = if (quotient_x == h_group_num) h_remainder else pe_num_p_h_group;
    const root_px_1st_phase: i16 = if (quotient_x == h_group_num) h_remainder / 2 else _root_px_1st_phase;
    const eff_gnum_x: i16 = h_group_num + (if (h_remainder > 0) @as(i16, 1) else @as(i16, 0));
    const center_gx: i16 = eff_gnum_x / 2;
    const center_root_1st_x: i16 = if (center_gx == h_group_num) h_remainder / 2 else _root_px_1st_phase;
    const root_px_2nd_phase: i16 = center_gx * pe_num_p_h_group + center_root_1st_x;

    const eff_pe_num_p_group_in_head: i16 = if (quotient_x_in_head == group_num_in_head) head_remainder else pe_num_p_group_in_head;
    const root_px_in_head_1st_phase = if (quotient_x_in_head == group_num_in_head) head_remainder / 2 else _root_px_in_head_1st_phase;
    const eff_gnum_xh: i16 = group_num_in_head + (if (head_remainder > 0) @as(i16, 1) else @as(i16, 0));
    const center_gxh: i16 = eff_gnum_xh / 2;
    const center_root_1st_xh: i16 = if (center_gxh == group_num_in_head) head_remainder / 2 else _root_px_in_head_1st_phase;
    const root_px_in_head_2nd_phase: i16 = center_gxh * pe_num_p_group_in_head + center_root_1st_xh;

    const eff_pe_num_p_v_group: i16 = if (quotient_y == v_group_num) v_remainder else pe_num_p_v_group;
    const root_py_1st_phase: i16 = if (quotient_y == v_group_num) v_remainder / 2 else _root_py_1st_phase;
    const eff_gnum_y: i16 = v_group_num + (if (v_remainder > 0) @as(i16, 1) else @as(i16, 0));
    const center_gy: i16 = eff_gnum_y / 2;
    const center_root_1st_y: i16 = if (center_gy == v_group_num) v_remainder / 2 else _root_py_1st_phase;
    const root_py_2nd_phase: i16 = center_gy * pe_num_p_v_group + center_root_1st_y;

    comm_mod.init(
        px, quotient_x, remainder_x, 
        py, quotient_y, remainder_y, 
        px_in_head, quotient_x_in_head, remainder_x_in_head,
        eff_pe_num_p_h_group, 
        eff_pe_num_p_v_group,
        root_px_1st_phase,
        root_px_2nd_phase,
        root_py_1st_phase,
        root_py_2nd_phase,
        eff_pe_num_p_group_in_head,
        root_px_in_head_1st_phase,
        root_px_in_head_2nd_phase,
    );

    alpha = 1.0 / @as(f16, math.sqrt(_head_dim));
    inv_dim = 1.0 / dim;

    sys_mod.unblock_cmd_stream();
}

const dest_dsr_1 = @get_dsr(dsr_dest, 1);
const src0_dsr_1 = @get_dsr(dsr_src0, 1);
const src1_dsr_1 = @get_dsr(dsr_src1, 1);

const dest_dsr_2 = @get_dsr(dsr_dest, 2);
const src0_dsr_2 = @get_dsr(dsr_src0, 2);
const src1_dsr_2 = @get_dsr(dsr_src1, 2);

const dest_dsr_3 = @get_dsr(dsr_dest, 3);
const src0_dsr_3 = @get_dsr(dsr_src0, 3);
const src1_dsr_3 = @get_dsr(dsr_src1, 3);

const dest_dsr_4 = @get_dsr(dsr_dest, 4);
const src0_dsr_4 = @get_dsr(dsr_src0, 4);
const src1_dsr_4 = @get_dsr(dsr_src1, 4);

fn gemv_static_step(cur: f16) void {
    @fmach(dest_dsr_1, src0_dsr_1, src1_dsr_1, cur);
}

fn fmulh_func(cur: f16) void {
    @fmulh(dest_dsr_1, src0_dsr_1, cur);
}

fn fsubh_func(cur: f16) void {
    @fsubh(dest_dsr_1, src0_dsr_1, cur);
}

var cur_: f16 = 0.0;
fn fmulh_norm_func(cur: f16) void {
    cur_ = cur * inv_dim;
    cur_ = 1.0 / math.sqrt(cur_ + eps);
    @fmulh(dest_dsr_1, src0_dsr_1, cur_);
}

fn fast_exp(x: f16) f16 {
    var tmp: f16 = x;
    tmp = 1.0 + tmp/256.0;
    tmp *= tmp;
    tmp *= tmp;

    return tmp;
}

fn fmulh_softmax_func(cur: f16) void {
    cur_ = 1.0 / cur;
    @fmulh(dest_dsr_1, src0_dsr_1, cur_);
}

var dummy = @zeros([1]f16);

var ptr_left_vector: [*]f16 = &dummy;
var left_vector_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &dummy, .extent = 1 });

var ptr_right_matrix: [*]f16 = &dummy;
var right_matrix_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &dummy, .extent = 1 });

var ptr_out_vector: [*]f16 = &dummy;
var out_vector_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &dummy, .extent = 1 });

// var h_dim_p_pe_dsd_1 = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{h_dim_p_pe} -> dummy[i] });   // not used
// var h_dim_p_pe_dsd_2 = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{h_dim_p_pe} -> dummy[i] });
var v_dim_p_pe_dsd_1 = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{v_dim_p_pe} -> dummy[i] });
var v_dim_p_pe_dsd_2 = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{v_dim_p_pe} -> dummy[i] });
var seq_len_p_pe_dsd_1 = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{seq_len_p_pe} -> dummy[i] });
var seq_len_p_pe_dsd_2 = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{seq_len_p_pe} -> dummy[i] });
var ffn_dim_p_pe_dsd_1 = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{ffn_dim_p_pe} -> dummy[i] });
var ffn_dim_p_pe_dsd_2 = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{ffn_dim_p_pe} -> dummy[i] });

var size1_chunk_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &dummy, .extent = 1 });

var Kt: i16 = 0;    // in_dimension
var Nt: i16 = 0;    // out_dimension

fn vecmat_computation() void {
    left_vector_dsd = @set_dsd_length(left_vector_dsd, @bitcast(u16, Kt));
    right_matrix_dsd = @set_dsd_length(right_matrix_dsd, @bitcast(u16, Nt));
    out_vector_dsd = @set_dsd_length(out_vector_dsd, @bitcast(u16, Nt));
    
    for (@range(i16, bsz)) |b| {
        right_matrix_dsd = @set_dsd_base_addr(right_matrix_dsd, ptr_right_matrix);

        @load_to_dsr(dest_dsr_1, out_vector_dsd, .{ .save_address = false });
        @load_to_dsr(src0_dsr_1, out_vector_dsd, .{ .save_address = false });
        @load_to_dsr(src1_dsr_1, right_matrix_dsd, .{ .save_address = true });

        @map(gemv_static_step, left_vector_dsd); // MFU 2x4Kx4K-flops

        left_vector_dsd = @increment_dsd_offset(left_vector_dsd, Kt, f16);
        out_vector_dsd = @increment_dsd_offset(out_vector_dsd, Nt, f16);
    }

}

// -------------------------------------------------------------------------- //
// ------------------------- Inline Assembly Functions ---------------------- //
// -------------------------------------------------------------------------- //

inline fn fh2xp16_to_down(dsr_dest_num: u16, dsr_src0_num: u16) void {
    asm volatile ("fh2xp16.down [dds%[dsr_dest_num]] = [s0ds%[dsr_src0_num]]"
                :: [dsr_dest_num] "n" (dsr_dest_num), [dsr_src0_num] "n" (dsr_src0_num), :"memory");
}

inline fn fminh(dsr_dest_num: u16, dsr_src0_num: u16, dsr_src1_num: u16) void {
    asm volatile ("fminh.nf [dds%[dsr_dest_num]] = [s0ds%[dsr_src0_num]] [s1ds%[dsr_src1_num]]"
                :: [dsr_dest_num] "n" (dsr_dest_num), [dsr_src0_num] "n" (dsr_src0_num), [dsr_src1_num] "n" (dsr_src1_num));
}

inline fn fscaleh(dsr_dest_num: u16, dsr_src0_num: u16, dsr_src1_num: u16) void {
    asm volatile ("fscaleh [dds%[dsr_dest_num]] = [s0ds%[dsr_src0_num]] [s1ds%[dsr_src1_num]]"
                :: [dsr_dest_num] "n" (dsr_dest_num), [dsr_src0_num] "n" (dsr_src0_num), [dsr_src1_num] "n" (dsr_src1_num));
}

inline fn fnormh(dsr_dest_num: u16, dsr_src0_num: u16) void {
   asm volatile ("fnormh [dds%[dsr_dest_num]] = [s0ds%[dsr_src0_num]]"
               :: [dsr_dest_num] "n" (dsr_dest_num), [dsr_src0_num] "n" (dsr_src0_num));
}

inline fn fcpxsh(dsr_dest_num: u16, dsr_src0_num: u16, dsr_src1_num: u16) void {
    asm volatile ("fcpxsh.nf [dds%[dsr_dest_num]] = [s0ds%[dsr_src0_num]] [s1ds%[dsr_src1_num]]"
                :: [dsr_dest_num] "n" (dsr_dest_num), [dsr_src0_num] "n" (dsr_src0_num), [dsr_src1_num] "n" (dsr_src1_num));
}

inline fn fdivsh(dsr_dest_num: u16, dsr_src0_num: u16, dsr_src1_num: u16) void {
    asm volatile ("fdivsh.nf [dds%[dsr_dest_num]] = [s0ds%[dsr_src0_num]] [s1ds%[dsr_src1_num]]"
                :: [dsr_dest_num] "n" (dsr_dest_num), [dsr_src0_num] "n" (dsr_src0_num), [dsr_src1_num] "n" (dsr_src1_num));
}

// -------------------------------------------------------------------------- //
// ------------------------- Transcendal Math Function ---------------------- //
// -------------------------------------------------------------------------- //

// Temporary variables for computation
const buf_size: u16 = if (seq_len_p_pe > ffn_dim_p_pe) bsz * seq_len_p_pe else bsz * ffn_dim_p_pe;
var i: [buf_size]i16;      // integer exponent (i)
var f: [buf_size]f16;
var t: [buf_size]f16;
var base_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &t, .extent = buf_size });

// constants for vectorized exp/reciprocal implementations
const threshold_p =  [1]f16 { 18.6355 };
const threshold_n =  [1]f16 { -18.6355 };
const constant_mask = [1]u32 { 0x66661166 };  // NaN:-inf,+inf:+0,-inf:-0,+0:-inf,-0:-inf,p:-inf,n:-inf
const constant_t =  [1]f16 { 2.001953125 };
const constant_m =  [1]u16 { 0x7794 };
const constant_one =  [1]f16 { 1.0 };
var constant_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &threshold_p, .extent = buf_size, .stride = 0 });

fn vectorized_exp_f16(size: u16, vector_in_ptr: [*]f16, vector_out_ptr: [*]f16) void {
    // set length, reset .save_address flag
    base_dsd = @set_dsd_length(base_dsd, size);
    constant_dsd = @set_dsd_length(constant_dsd, size);
    @load_to_dsr(dest_dsr_1, base_dsd);
    @load_to_dsr(src0_dsr_1, base_dsd);
    @load_to_dsr(dest_dsr_2, base_dsd);
    @load_to_dsr(src0_dsr_2, base_dsd);
    @load_to_dsr(src1_dsr_2, base_dsd);

    // Step 0: x = fmin(+16.63, x); /* put this first so as to treat NaNs like +INF */
    //         x = fmax(-16.63, x);
    @load_to_dsr(src1_dsr_1, constant_dsd);
    // @set_dsr_base_addr(dest_dsr_1, &t);  // base_dsd already set base_addr to &t
    @set_dsr_base_addr(src0_dsr_1, vector_in_ptr);
    fminh(1, 1, 1); // @fminh(dest_dsr_1, src0_dsr_1, src1_dsr_1);
    @set_dsr_base_addr(src1_dsr_1, &threshold_n);
    @set_dsr_base_addr(src0_dsr_1, &t);
    @fmaxh(dest_dsr_1, src0_dsr_1, src1_dsr_1);

    // Step 1: float t = x * 1.442695041f;
    @fmulh(dest_dsr_1, src0_dsr_1, 1.442695);   // t shares memory with x

    // Step 2: float fi = floorf (t);
    //         int i = (int)fi;
    @set_dsr_base_addr(dest_dsr_1, &f);  // fi shares memory with f
    @load_to_dsr(src1_dsr_1, base_dsd);  // reset stride to 1 (originally 0), length is inherited from constant
    @set_dsr_base_addr(src1_dsr_1, &f);    
    @set_dsr_base_addr(dest_dsr_2, &i);
    @set_dsr_base_addr(src1_dsr_2, &i);
    fh2xp16_to_down(2, 1);  // @fh2xp16(dest_dsr_2, src0_dsr_1);
    @xp162fh(dest_dsr_1, src1_dsr_2);

    // Step 3: float f = t - fi;
    @fsubh(dest_dsr_1, src0_dsr_1, src1_dsr_1);

    // Step 4: float p = f;
    //         float c = 1.0000063181;
    @set_dsr_base_addr(src0_dsr_1, &f);
    @set_dsr_base_addr(dest_dsr_2, vector_out_ptr);
    @set_dsr_base_addr(dest_dsr_1, &t);  // p shares memory with t
    @faddh(dest_dsr_1, src0_dsr_1, 0.0);
    @fmovh(dest_dsr_2, 1.0000063181);

    // Step 5: Polynomial approximation (4th degree Horner method)
    @set_dsr_base_addr(src1_dsr_1, &t);
    @set_dsr_base_addr(src0_dsr_2, vector_out_ptr);
    // c = fmaf(6.9293457270e-01, p, c);
    @fmach(dest_dsr_2, src0_dsr_2, src1_dsr_1, 6.9293457270e-01);
    // p *= f; c = fmaf(2.4169936776e-01, p, c);
    @fmulh(dest_dsr_1, src0_dsr_1, src1_dsr_1);
    @fmach(dest_dsr_2, src0_dsr_2, src1_dsr_1, 2.4169936776e-01);
    // p *= f; c = fmaf(5.1688175648e-02, p, c);
    @fmulh(dest_dsr_1, src0_dsr_1, src1_dsr_1);
    @fmach(dest_dsr_2, src0_dsr_2, src1_dsr_1, 5.1688175648e-02);
    // p *= f; c = fmaf(1.3665339909e-02, p, c);
    @fmulh(dest_dsr_1, src0_dsr_1, src1_dsr_1);
    @fmach(dest_dsr_2, src0_dsr_2, src1_dsr_1, 1.3665339909e-02);
    
    // Step 6: Scale c from the range between 1 and 2
    //         c = fscale(c, i);
    fscaleh(2, 2, 2); // @fscaleh(dest_dsr_2, src0_dsr_2, src1_dsr_2);
}

fn vectorized_reciprocal_f16(size: u16, vector_in_ptr: [*]f16, vector_out_ptr: [*]f16) void {
  // WARNING: THIS FUNCTION IS DESTRUCTIVE, VECTOR_IN WILL NOT KEEP ITS VALUE
  // set length, reset .save_address flag
  base_dsd = @set_dsd_length(base_dsd, size);
  constant_dsd = @set_dsd_length(constant_dsd, size);
  @load_to_dsr(dest_dsr_1, base_dsd);
  @load_to_dsr(src0_dsr_1, base_dsd);
  @load_to_dsr(dest_dsr_2, base_dsd);
  @load_to_dsr(src0_dsr_2, base_dsd);
  @load_to_dsr(src1_dsr_2, base_dsd);

  // Step 0: Division starter for Half precision
  // if !isfinite(x)
  //     return Float16(1.0)/x
  // end # fdivsh e = one,x (division starter function)
  // (x,e) = frexp(x) # fnormh x = x
  @load_to_dsr(src1_dsr_1, constant_dsd);
  @set_dsr_base_addr(dest_dsr_1, &t);
  @set_dsr_base_addr(src0_dsr_1, vector_in_ptr);
  @set_dsr_base_addr(src1_dsr_1, &constant_mask);
  fcpxsh(1, 1, 1);
  @set_dsr_base_addr(src0_dsr_1, &t);
  @sar16(dest_dsr_1, src0_dsr_1, 15);

  @load_to_dsr(src1_dsr_1, base_dsd);
  @load_to_dsr(src0_dsr_3, constant_dsd);
  @set_dsr_base_addr(dest_dsr_1, &i);   // e uses region of i
  @set_dsr_base_addr(src0_dsr_3, &constant_one);
  @set_dsr_base_addr(src1_dsr_1, vector_in_ptr);
  fdivsh(1, 3, 1); // @fdivsh(dest_dsr_1, src0_dsr_1, src1_dsr_1);
  @set_dsr_base_addr(dest_dsr_2, vector_in_ptr);
  @set_dsr_base_addr(src0_dsr_2, vector_in_ptr);
  fnormh(2, 2);

  // Step 1: Kahan's starting guess, yields rel. err. <0.06
  @set_dsr_base_addr(dest_dsr_2, vector_out_ptr);
  @set_dsr_base_addr(src0_dsr_3, &constant_m);
  @sub16(dest_dsr_2, src0_dsr_3, src1_dsr_1);   // y::Float16 = reinterpret(Float16,M - reinterpret(UInt16,x)) # sub16.nf y = M,x

  // Step 2: First Newton iteration, yields rel. err. <4e-3
  // d::Float16 = fma(-x,y,t)    # fmsh  d = t,x,y
  // y *= d                      # fmulh y = y,d
  @set_dsr_base_addr(dest_dsr_1, &f);   // d uses region of f
  @set_dsr_base_addr(src1_dsr_1, &f);
  @set_dsr_base_addr(src1_dsr_2, vector_out_ptr);
  @set_dsr_base_addr(src0_dsr_1, vector_out_ptr);
  @set_dsr_base_addr(src0_dsr_3, &constant_t);
  @fmulh(dest_dsr_1, src0_dsr_2, src1_dsr_2);
  @fsubh(dest_dsr_1, src0_dsr_3, src1_dsr_1);
  @fmulh(dest_dsr_2, src0_dsr_1 ,src1_dsr_1);

  // Step 3: Second Newton iteration, yields re. err. ~0.5ulp
  // d = fma(-x,y,one)           # fmsh d = one,x,y
  // d *= y                      # fmulh d = d,y
  // y += d                      # faddh y = y,d
  @set_dsr_base_addr(src0_dsr_3, &constant_one);
  @fmulh(dest_dsr_1, src0_dsr_2, src1_dsr_2);
  @fsubh(dest_dsr_1, src0_dsr_3, src1_dsr_1);
  @fmulh(dest_dsr_1, src0_dsr_1, src1_dsr_1);
  @faddh(dest_dsr_2, src0_dsr_1, src1_dsr_1);
  
  // Step 4: y = ldexp(y,-e)
  // fscaleh y = y,e (e has correct sign from fdivsh)
  // select16 result = y, e (flag set by fdivsh)
  @set_dsr_base_addr(src1_dsr_2, &i);   // e uses region of i
  @set_dsr_base_addr(src0_dsr_2, vector_out_ptr);
  fscaleh(2, 2, 2); // @fscaleh(dest_dsr_2, src0_dsr_2, src1_dsr_2);
  // select16(2, 2, 2); // UNAVAILABLE because CF is not vectorized 
  // m = 0xFFFF if (x != inf and x != -inf) else 0x0000
  @set_dsr_base_addr(src1_dsr_2, &t);
  @and16(dest_dsr_2, src0_dsr_2, src1_dsr_2);         // y = y & m
}

