    //     20 => {  // X_1st=4, X_2nd=8
    //         // @fmovh(reduce_1st_1_send_dsr, vector_buf_s1dsr);
    //         // @mov32(ctrl_1st_0_dsr, ctrl_buf_dsr);
    //         // @mov32(ctrl_1st_1_dsr, ctrl_buf_dsr);
