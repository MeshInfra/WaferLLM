    //     },
    //     15 => {  // X_1st=3, X_2nd=6
    //         // @faddh(reduce_1st_0_send_dsr, reduce_1st_1_recv_dsr, vector_buf_s1dsr);
    //         // @mov32(ctrl_1st_0_dsr, ctrl_buf_dsr);
    //         // @mov32(ctrl_2nd_1_dsr, ctrl_buf_dsr);
