    //         // @faddh(reduce_1st_1_send_dsr, reduce_1st_0_recv_dsr, vector_buf_s1dsr);
    //         // @mov32(ctrl_1st_1_dsr, ctrl_buf_dsr);
    //         // @mov32(ctrl_2nd_1_dsr, ctrl_buf_dsr);
    //         reduce_reset_case_21();
    //     },
    //     22 => {  // X_1st=5, X_2nd=7
    //         // @faddh(reduce_1st_1_send_dsr, reduce_1st_0_recv_dsr, vector_buf_s1dsr);
    //         // @mov32(ctrl_1st_1_dsr, ctrl_buf_dsr);
    //         // @mov32(ctrl_2nd_0_dsr, ctrl_buf_dsr);
    //         reduce_reset_case_22();
    //     },
    //     23 => {  // X_1st=5, X_2nd=8
    //         // @faddh(reduce_1st_1_send_dsr, reduce_1st_0_recv_dsr, vector_buf_s1dsr);
    //         // @mov32(ctrl_1st_1_dsr, ctrl_buf_dsr);
    //         // @mov32(ctrl_2nd_0_dsr, ctrl_buf_dsr);
    //         // @mov32(ctrl_2nd_1_dsr, ctrl_buf_dsr);
    //         reduce_reset_case_23();
    //     },
    //     else => {},
    // }
    reduce_reset_funcs[reduce_pe_type]();


    if (bdcast_pe_type == 0) {
        @mov16(bdcast_send_dsr, vector_buf_s1dsr);
        @mov32(ctrl_bdcast_dsr, ctrl_buf_dsr);
    } else {
        @mov16(vector_buf_ddsr, bdcast_recv_dsr);
    }

    @block(reduce_1st_0_recv_queue_id);
    @block(reduce_1st_1_recv_queue_id);
    @block(reduce_2nd_0_recv_queue_id);
    @block(reduce_2nd_1_recv_queue_id);
    @block(broadcast_recv_queue_id);
}

