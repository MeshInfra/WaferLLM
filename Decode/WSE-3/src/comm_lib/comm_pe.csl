// ====================== all reduce with reset ================= //
fn all_reduce_with_reset(size: u16, vector_buf_ptr: [*]f16, c_axis: comm_axis) void {
    @set_dsr_length(reduce_1st_0_send_dsr, size);
    @set_dsr_length(reduce_1st_1_send_dsr, size);
    @set_dsr_length(reduce_2nd_0_send_dsr, size);
    @set_dsr_length(reduce_2nd_1_send_dsr, size);
    @set_dsr_length(bdcast_send_dsr, size);

    @set_dsr_length(reduce_1st_0_recv_dsr, size);
    @set_dsr_length(reduce_1st_1_recv_dsr, size);
    @set_dsr_length(reduce_2nd_0_recv_dsr, size);
    @set_dsr_length(reduce_2nd_1_recv_dsr, size);
    @set_dsr_length(bdcast_recv_dsr, size);

    vector_buf_dsd = @set_dsd_length(vector_buf_dsd, size);
    vector_buf_dsd = @set_dsd_base_addr(vector_buf_dsd, vector_buf_ptr);
    @load_to_dsr(vector_buf_ddsr, vector_buf_dsd);
    @load_to_dsr(vector_buf_s1dsr, vector_buf_dsd);

    switch (c_axis) {
        comm_axis.horizontal => {
            reduce_pe_type = X_reduce_pe_type;
            bdcast_pe_type = X_bdcast_pe_type;
        },
        comm_axis.vertical => {
            reduce_pe_type = Y_reduce_pe_type;
            bdcast_pe_type = Y_bdcast_pe_type;
        },
        comm_axis.horizontal_in_head => {
            reduce_pe_type = XH_reduce_pe_type;
            bdcast_pe_type = XH_bdcast_pe_type;
