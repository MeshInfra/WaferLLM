fn get_params(
    px: i16, 
    quotient_x: i16, 
    remainder_x: i16, 
    py: i16, 
    quotient_y: i16, 
    remainder_y: i16,
    px_in_head: i16,
    quotient_x_in_head: i16,
    remainder_x_in_head: i16,
) void {
    const quotient_x_even: bool = (quotient_x % 2) == 0;
    const quotient_y_even: bool = (quotient_y % 2) == 0;
    const remainder_x_even: bool = (remainder_x % 2) == 0;
    const remainder_y_even: bool = (remainder_y % 2) == 0;

    // @comptime_print("(px, py)=", px, py);
    // @comptime_print("(quotient_x, remainder_x, quotient_y, remainder_y)=", quotient_x, remainder_x, quotient_y, remainder_y);
    // @comptime_print("(quotient_x_in_head, remainder_x_in_head)=", quotient_x_in_head, remainder_x_in_head);
    // @comptime_print(eff_root_1st_x, eff_root_2nd_x, eff_root_1st_y, eff_root_2nd_y, eff_root_1st_xh, eff_root_2nd_xh);

    // Phase 1 reduceFn:
        // remainder_x or remainder_y == root_1st_phase:
            // Even-numbered remainder_x or remainder_y: color 0 receives from HEAD, color 1 receives from TAIL
            // Odd-numbered remainder_x or remainder_y: color 1 receives from HEAD, color 0 receives from TAIL
        // (remainder_x or remainder_y < root_1st_phase):
            // Even-numbered remainder_x or remainder_y: color 0 receives from HEAD, color 1 sends to TAIL
            // Odd-numbered remainder_x or remainder_y: color 1 receives from HEAD, color 0 sends to TAIL
        // (remainder_x or remainder_y > root_1st_phase):
            // Even-numbered remainder_x or remainder_y: color 1 receives from TAIL, color 0 sends to HEAD
            // Odd-numbered remainder_x or remainder_y: color 0 receives from TAIL, color 1 sends to HEAD

    // Phase 2 reduceFn:
        // px or py == root_2nd_phase:
            // Even-numbered quotient_x or quotient_y: color 0 receives from HEAD, color 1 receives from TAIL
            // Odd-numbered quotient_x or quotient_y: color 1 receives from HEAD, color 0 receives from TAIL
        // (px or py < root_2nd_phase) and (remainder_x or remainder_y == root_1st_phase):
            // Even-numbered quotient_x or quotient_y: color 0 receives from HEAD, color 1 sends to TAIL
            // Odd-numbered quotient_x or quotient_y: color 1 receives from HEAD, color 0 sends to TAIL
        // (px or py > root_2nd_phase) and (remainder_x or remainder_y == root_1st_phase):
            // Even-numbered quotient_x or quotient_y: color 1 receives from TAIL, color 0 sends to HEAD
            // Odd-numbered quotient_x or quotient_y: color 0 receives from TAIL, color 1 sends to HEAD

        // HEAD: WEST, NORTH
        // TAIL: EAST, SOUTH

    if (remainder_x == root_px_1st_phase) {
        if (remainder_x_even) {
            if (remainder_x == pe_num_p_h_group - 1) {
                X_1st_RD_0.rx = WEST;
                X_1st_RD_1.rx = RAMP;
            } else {
                X_1st_RD_0.rx = WEST;
                X_1st_RD_1.rx = EAST;
            }
        } else {
            if (remainder_x == pe_num_p_h_group - 1) {
                X_1st_RD_1.rx = WEST;
                X_1st_RD_0.rx = RAMP;
            } else {
                X_1st_RD_1.rx = WEST;
                X_1st_RD_0.rx = EAST;
            }
        }
    } else if (remainder_x < root_px_1st_phase) {
        if (remainder_x_even) {
            if (remainder_x == 0) {
                X_1st_RD_0.rx = RAMP;
                X_1st_RD_0.tx[0] = RAMP;
                X_1st_RD_1.rx = RAMP;
                X_1st_RD_1.tx[0] = EAST;
            } else {
                X_1st_RD_0.rx = WEST;
                X_1st_RD_0.tx[0] = RAMP;
                X_1st_RD_1.rx = RAMP;
                X_1st_RD_1.tx[0] = EAST;
            }
        } else {
            // remainder_x % 2 == 1
            X_1st_RD_1.rx = WEST;
            X_1st_RD_1.tx[0] = RAMP;
            X_1st_RD_0.rx = RAMP;
            X_1st_RD_0.tx[0] = EAST;
        }
    } else {
        // remainder_x > root_1st_phase
        if (remainder_x_even) {
            if (remainder_x == pe_num_p_h_group - 1) {
                X_1st_RD_1.rx = RAMP;
                X_1st_RD_1.tx[0] = RAMP;
                X_1st_RD_0.rx = RAMP;
                X_1st_RD_0.tx[0] = WEST;
            } else {
                X_1st_RD_1.rx = EAST;
                X_1st_RD_1.tx[0] = RAMP;
                X_1st_RD_0.rx = RAMP;
                X_1st_RD_0.tx[0] = WEST;
            }
        } else {
            // remainder_x % 2 == 1
            if (remainder_x == pe_num_p_h_group - 1) {
                X_1st_RD_0.rx = RAMP;
                X_1st_RD_0.tx[0] = RAMP;
                X_1st_RD_1.rx = RAMP;
                X_1st_RD_1.tx[0] = WEST;
            } else {
                X_1st_RD_0.rx = EAST;
                X_1st_RD_0.tx[0] = RAMP;
                X_1st_RD_1.rx = RAMP;
                X_1st_RD_1.tx[0] = WEST;
            }
        }
    }

    if (remainder_y == root_py_1st_phase) {
        if (remainder_y_even) {
            if (remainder_y == pe_num_p_v_group - 1) {
                Y_1st_RD_0.rx = NORTH;
                Y_1st_RD_1.rx = RAMP;
            } else {
                Y_1st_RD_0.rx = NORTH;
                Y_1st_RD_1.rx = SOUTH;
            }
        } else {
            if (remainder_y == pe_num_p_v_group - 1) {
                Y_1st_RD_1.rx = NORTH;
                Y_1st_RD_0.rx = RAMP;
            } else {
                Y_1st_RD_1.rx = NORTH;
                Y_1st_RD_0.rx = SOUTH;
            }
        }
    } else if (remainder_y < root_py_1st_phase) {
        if (remainder_y_even) {
            if (remainder_y == 0) {
                Y_1st_RD_0.rx = RAMP;
                Y_1st_RD_0.tx[0] = RAMP;
                Y_1st_RD_1.rx = RAMP;
                Y_1st_RD_1.tx[0] = SOUTH;
            } else {
                Y_1st_RD_0.rx = NORTH;
                Y_1st_RD_0.tx[0] = RAMP;
                Y_1st_RD_1.rx = RAMP;
                Y_1st_RD_1.tx[0] = SOUTH;
            }
        } else {
            Y_1st_RD_1.rx = NORTH;
            Y_1st_RD_1.tx[0] = RAMP;
            Y_1st_RD_0.rx = RAMP;
            Y_1st_RD_0.tx[0] = SOUTH;
        }
    } else {
        if (remainder_y_even) {
            if (remainder_y == pe_num_p_v_group - 1) {
                Y_1st_RD_1.rx = RAMP;
                Y_1st_RD_1.tx[0] = RAMP;
                Y_1st_RD_0.rx = RAMP;
                Y_1st_RD_0.tx[0] = NORTH;
            } else {
                Y_1st_RD_1.rx = SOUTH;
                Y_1st_RD_1.tx[0] = RAMP;
                Y_1st_RD_0.rx = RAMP;
                Y_1st_RD_0.tx[0] = NORTH;
            }
        } else {
            if (remainder_y == pe_num_p_v_group - 1) {
                Y_1st_RD_0.rx = RAMP;
                Y_1st_RD_0.tx[0] = RAMP;
                Y_1st_RD_1.rx = RAMP;
                Y_1st_RD_1.tx[0] = NORTH;
            } else {
                Y_1st_RD_0.rx = SOUTH;
                Y_1st_RD_0.tx[0] = RAMP;
                Y_1st_RD_1.rx = RAMP;
                Y_1st_RD_1.tx[0] = NORTH;
            }
        }
    }

    if (remainder_x_in_head == root_px_in_head_1st_phase) {
        if (remainder_x_in_head % 2 == 0) {
            if (remainder_x_in_head == pe_num_p_group_in_head - 1) {
                X_1st_RD_IN_H_0.rx = WEST;
                X_1st_RD_IN_H_1.rx = RAMP;
            } else {
                X_1st_RD_IN_H_0.rx = WEST;
                X_1st_RD_IN_H_1.rx = EAST;
            }
        } else {
            if (remainder_x_in_head == pe_num_p_group_in_head - 1) {
                X_1st_RD_IN_H_1.rx = WEST;
                X_1st_RD_IN_H_0.rx = RAMP;
            } else {
                X_1st_RD_IN_H_1.rx = WEST;
                X_1st_RD_IN_H_0.rx = EAST;
            }
        }
    } else if (remainder_x_in_head < root_px_in_head_1st_phase) {
        if (remainder_x_in_head % 2 == 0) {
            if (remainder_x_in_head == 0) {
                X_1st_RD_IN_H_0.rx = RAMP;
                X_1st_RD_IN_H_0.tx[0] = RAMP;
                X_1st_RD_IN_H_1.rx = RAMP;
                X_1st_RD_IN_H_1.tx[0] = EAST;
            } else {
                X_1st_RD_IN_H_0.rx = WEST;
                X_1st_RD_IN_H_0.tx[0] = RAMP;
                X_1st_RD_IN_H_1.rx = RAMP;
                X_1st_RD_IN_H_1.tx[0] = EAST;
            }
        } else {
            if (remainder_x_in_head == 0) {
                X_1st_RD_IN_H_1.rx = RAMP;
                X_1st_RD_IN_H_1.tx[0] = RAMP;
                X_1st_RD_IN_H_0.rx = RAMP;
                X_1st_RD_IN_H_0.tx[0] = EAST;
            } else {
                X_1st_RD_IN_H_1.rx = WEST;
                X_1st_RD_IN_H_1.tx[0] = RAMP;
                X_1st_RD_IN_H_0.rx = RAMP;
                X_1st_RD_IN_H_0.tx[0] = EAST;
            }
        }
    } else {
        if (remainder_x_in_head % 2 == 0) {
            if (remainder_x_in_head == pe_num_p_group_in_head - 1) {
                X_1st_RD_IN_H_1.rx = RAMP;
                X_1st_RD_IN_H_1.tx[0] = RAMP;
                X_1st_RD_IN_H_0.rx = RAMP;
                X_1st_RD_IN_H_0.tx[0] = WEST;
            } else {
                X_1st_RD_IN_H_1.rx = EAST;
                X_1st_RD_IN_H_1.tx[0] = RAMP;
                X_1st_RD_IN_H_0.rx = RAMP;
                X_1st_RD_IN_H_0.tx[0] = WEST;
            }
        } else {
            if (remainder_x_in_head == pe_num_p_group_in_head - 1) {
                X_1st_RD_IN_H_0.rx = RAMP;
                X_1st_RD_IN_H_0.tx[0] = RAMP;
                X_1st_RD_IN_H_1.rx = RAMP;
                X_1st_RD_IN_H_1.tx[0] = WEST;
            } else {
                X_1st_RD_IN_H_0.rx = EAST;
                X_1st_RD_IN_H_0.tx[0] = RAMP;
                X_1st_RD_IN_H_1.rx = RAMP;
                X_1st_RD_IN_H_1.tx[0] = WEST;
            }
        }
    }

    if (px == root_px_2nd_phase) {
        if (root_px_2nd_phase < Pw - pe_num_p_last_h_group) {
            if (quotient_x_even) {
                X_2nd_RD_0.rx = WEST;
                X_2nd_RD_1.rx = EAST;
            } else {
                X_2nd_RD_1.rx = WEST;
                X_2nd_RD_0.rx = EAST;
            }
        } else {
            if (quotient_x_even) {  // should not be selected
                X_2nd_RD_0.rx = RAMP;
                X_2nd_RD_1.rx = EAST;
            } else {
                X_2nd_RD_1.rx = WEST;
                X_2nd_RD_0.rx = RAMP;
            }
        }
    } else if (px < root_px_2nd_phase) {    // from WEST to EAST
        if (remainder_x == root_px_1st_phase) {
            if (px < pe_num_p_h_group) {
                X_2nd_RD_0.rx = RAMP;
                X_2nd_RD_0.tx[0] = RAMP;
                X_2nd_RD_1.rx = RAMP;
                X_2nd_RD_1.tx[0] = EAST;
            } else {
                if (quotient_x % 2 == 0) {
                    X_2nd_RD_0.rx = WEST;
                    X_2nd_RD_0.tx[0] = RAMP;
                    X_2nd_RD_1.rx = RAMP;
                    X_2nd_RD_1.tx[0] = EAST;
                } else {
                    X_2nd_RD_1.rx = WEST;
                    X_2nd_RD_1.tx[0] = RAMP;
                    X_2nd_RD_0.rx = RAMP;
                    X_2nd_RD_0.tx[0] = EAST;
                }
            }
        } else if (remainder_x > root_px_1st_phase) {
            if (quotient_x % 2 == 0) {
                X_2nd_RD_0.rx = RAMP;
                X_2nd_RD_0.tx[0] = RAMP;
                X_2nd_RD_1.rx = WEST;
                X_2nd_RD_1.tx[0] = EAST;
            } else {
                X_2nd_RD_0.rx = WEST;
                X_2nd_RD_0.tx[0] = EAST;
                X_2nd_RD_1.rx = RAMP;
                X_2nd_RD_1.tx[0] = RAMP;
            }
        } else {
            if (quotient_x == 0) {
                // nothing to be relayed
                X_2nd_RD_0.rx = RAMP;
                X_2nd_RD_0.tx[0] = RAMP;
                X_2nd_RD_1.rx = RAMP;
                X_2nd_RD_1.tx[0] = RAMP;
            } else if (quotient_x % 2 == 0) {
                X_2nd_RD_0.rx = WEST;
                X_2nd_RD_0.tx[0] = EAST;
                X_2nd_RD_1.rx = RAMP;
                X_2nd_RD_1.tx[0] = RAMP;
            } else {
                X_2nd_RD_0.rx = RAMP;
                X_2nd_RD_0.tx[0] = RAMP;
                X_2nd_RD_1.rx = WEST;
                X_2nd_RD_1.tx[0] = EAST;
            }
        }
    } else {    // from EAST to WEST
        if (remainder_x == root_px_1st_phase) {
            if (px > Pw - pe_num_p_last_h_group - 1) {
                if (quotient_x % 2 == 0) {
                    X_2nd_RD_1.rx = RAMP;
                    X_2nd_RD_1.tx[0] = RAMP;
                    X_2nd_RD_0.rx = RAMP;
                    X_2nd_RD_0.tx[0] = WEST;
                } else {
                    X_2nd_RD_0.rx = RAMP;
                    X_2nd_RD_0.tx[0] = RAMP;
                    X_2nd_RD_1.rx = RAMP;
                    X_2nd_RD_1.tx[0] = WEST;
                }
            } else {
                if (quotient_x % 2 == 0) {
                    X_2nd_RD_1.rx = EAST;
                    X_2nd_RD_1.tx[0] = RAMP;
                    X_2nd_RD_0.rx = RAMP;
                    X_2nd_RD_0.tx[0] = WEST;
                } else {
                    X_2nd_RD_0.rx = EAST;
                    X_2nd_RD_0.tx[0] = RAMP;
                    X_2nd_RD_1.rx = RAMP;
                    X_2nd_RD_1.tx[0] = WEST;
                }
            }
        } else if (remainder_x < root_px_1st_phase) {
            if (quotient_x % 2 == 0) {
                X_2nd_RD_0.rx = EAST;
                X_2nd_RD_0.tx[0] = WEST;
                X_2nd_RD_1.rx = RAMP;
                X_2nd_RD_1.tx[0] = RAMP;
            } else {
                X_2nd_RD_0.rx = RAMP;
                X_2nd_RD_0.tx[0] = RAMP;
                X_2nd_RD_1.rx = EAST;
                X_2nd_RD_1.tx[0] = WEST;
            }
        } else {
            if (quotient_x == eff_gnum_x - 1) {
                // nothing to be relayed
                X_2nd_RD_0.rx = RAMP;
                X_2nd_RD_0.tx[0] = RAMP;
                X_2nd_RD_1.rx = RAMP;
                X_2nd_RD_1.tx[0] = RAMP;
            } else if (quotient_x % 2 == 0) {
                X_2nd_RD_0.rx = RAMP;
                X_2nd_RD_0.tx[0] = RAMP;
                X_2nd_RD_1.rx = EAST;
                X_2nd_RD_1.tx[0] = WEST;
            } else {
                X_2nd_RD_0.rx = EAST;
                X_2nd_RD_0.tx[0] = WEST;
                X_2nd_RD_1.rx = RAMP;
                X_2nd_RD_1.tx[0] = RAMP;
            }
        }
    }

    if (py == root_py_2nd_phase) {
        if (root_py_2nd_phase < Ph - pe_num_p_last_v_group) {
            if (quotient_y_even) {
                Y_2nd_RD_0.rx = NORTH;
                Y_2nd_RD_1.rx = SOUTH;
            } else {
                Y_2nd_RD_1.rx = NORTH;
                Y_2nd_RD_0.rx = SOUTH;
            }
        } else {
            if (quotient_y_even) {  // should not be selected
                Y_2nd_RD_0.rx = RAMP;
                Y_2nd_RD_1.rx = SOUTH;
            } else {
                Y_2nd_RD_1.rx = NORTH;
                Y_2nd_RD_0.rx = RAMP;
            }
        }
    } else if (py < root_py_2nd_phase) {    // from NORTH to SOUTH
        if (remainder_y == root_py_1st_phase) {
            if (py < pe_num_p_v_group) {
                Y_2nd_RD_0.rx = RAMP;
                Y_2nd_RD_0.tx[0] = RAMP;
                Y_2nd_RD_1.rx = RAMP;
                Y_2nd_RD_1.tx[0] = SOUTH;
            } else {
                if (quotient_y % 2 == 0) {
                    Y_2nd_RD_0.rx = NORTH;
                    Y_2nd_RD_0.tx[0] = RAMP;
                    Y_2nd_RD_1.rx = RAMP;
                    Y_2nd_RD_1.tx[0] = SOUTH;
                } else {
                    Y_2nd_RD_1.rx = NORTH;
                    Y_2nd_RD_1.tx[0] = RAMP;
                    Y_2nd_RD_0.rx = RAMP;
                    Y_2nd_RD_0.tx[0] = SOUTH;
                }
            }
        } else if (remainder_y > root_py_1st_phase) {
            if (quotient_y % 2 == 0) {
                Y_2nd_RD_0.rx = RAMP;
                Y_2nd_RD_0.tx[0] = RAMP;
                Y_2nd_RD_1.rx = NORTH;
                Y_2nd_RD_1.tx[0] = SOUTH;
            } else {
                Y_2nd_RD_0.rx = NORTH;
                Y_2nd_RD_0.tx[0] = SOUTH;
                Y_2nd_RD_1.rx = RAMP;
                Y_2nd_RD_1.tx[0] = RAMP;
            }
        } else {
            if (quotient_y == 0) {
                // nothing to be relayed
                Y_2nd_RD_0.rx = RAMP;
                Y_2nd_RD_0.tx[0] = RAMP;
                Y_2nd_RD_1.rx = RAMP;
                Y_2nd_RD_1.tx[0] = RAMP;
            } else if (quotient_y % 2 == 0) {
                Y_2nd_RD_0.rx = NORTH;
                Y_2nd_RD_0.tx[0] = SOUTH;
                Y_2nd_RD_1.rx = RAMP;
                Y_2nd_RD_1.tx[0] = RAMP;
            } else {
                Y_2nd_RD_0.rx = RAMP;
                Y_2nd_RD_0.tx[0] = RAMP;
                Y_2nd_RD_1.rx = NORTH;
                Y_2nd_RD_1.tx[0] = SOUTH;
            }
        }
    } else {    // from SOUTH to NORTH
        if (remainder_y == root_py_1st_phase) {
            if (py > Ph - pe_num_p_last_v_group - 1) {
                if (quotient_y % 2 == 0) {
                    Y_2nd_RD_1.rx = RAMP;
                    Y_2nd_RD_1.tx[0] = RAMP;
                    Y_2nd_RD_0.rx = RAMP;
                    Y_2nd_RD_0.tx[0] = NORTH;
                } else {
                    Y_2nd_RD_0.rx = RAMP;
                    Y_2nd_RD_0.tx[0] = RAMP;
                    Y_2nd_RD_1.rx = RAMP;
                    Y_2nd_RD_1.tx[0] = NORTH;
                }
            } else {
                if (quotient_y % 2 == 0) {
                    Y_2nd_RD_1.rx = SOUTH;
                    Y_2nd_RD_1.tx[0] = RAMP;
                    Y_2nd_RD_0.rx = RAMP;
                    Y_2nd_RD_0.tx[0] = NORTH;
                } else {
                    Y_2nd_RD_0.rx = SOUTH;
                    Y_2nd_RD_0.tx[0] = RAMP;
                    Y_2nd_RD_1.rx = RAMP;
                    Y_2nd_RD_1.tx[0] = NORTH;
                }
            }
        } else if (remainder_y < root_py_1st_phase) {
            if (quotient_y % 2 == 0) {
                Y_2nd_RD_0.rx = SOUTH;
                Y_2nd_RD_0.tx[0] = NORTH;
                Y_2nd_RD_1.rx = RAMP;
                Y_2nd_RD_1.tx[0] = RAMP;
            } else {
                Y_2nd_RD_0.rx = RAMP;
                Y_2nd_RD_0.tx[0] = RAMP;
                Y_2nd_RD_1.rx = SOUTH;
                Y_2nd_RD_1.tx[0] = NORTH;
            }
        } else {
            if (quotient_y == eff_gnum_y - 1) {
                // nothing to be relayed
                Y_2nd_RD_0.rx = RAMP;
                Y_2nd_RD_0.tx[0] = RAMP;
                Y_2nd_RD_1.rx = RAMP;
                Y_2nd_RD_1.tx[0] = RAMP;
            } else if (quotient_y % 2 == 0) {
                Y_2nd_RD_0.rx = RAMP;
                Y_2nd_RD_0.tx[0] = RAMP;
                Y_2nd_RD_1.rx = SOUTH;
                Y_2nd_RD_1.tx[0] = NORTH;
            } else {
                Y_2nd_RD_0.rx = SOUTH;
                Y_2nd_RD_0.tx[0] = NORTH;
                Y_2nd_RD_1.rx = RAMP;
                Y_2nd_RD_1.tx[0] = RAMP;
            }
        }
    }

    if (px_in_head == root_px_in_head_2nd_phase) {
        if (root_px_in_head_2nd_phase < pes_p_head - pe_num_p_last_group_in_head) {
            if (quotient_x_in_head % 2 == 0) {
                X_2nd_RD_IN_H_0.rx = WEST;
                X_2nd_RD_IN_H_1.rx = EAST;
            } else {
                X_2nd_RD_IN_H_1.rx = WEST;
                X_2nd_RD_IN_H_0.rx = EAST;
            }
        } else {
            if (quotient_x_in_head % 2 == 0) {  // should not be selected
                X_2nd_RD_IN_H_0.rx = RAMP;
                X_2nd_RD_IN_H_1.rx = EAST;
            } else {
                X_2nd_RD_IN_H_1.rx = WEST;
                X_2nd_RD_IN_H_0.rx = RAMP;
            }
        }
    } else if (px_in_head < root_px_in_head_2nd_phase) {    // from WEST to EAST
        if (remainder_x_in_head == root_px_in_head_1st_phase) {
            if (px_in_head < pe_num_p_group_in_head) {
                X_2nd_RD_IN_H_0.rx = RAMP;
                X_2nd_RD_IN_H_0.tx[0] = RAMP;
                X_2nd_RD_IN_H_1.rx = RAMP;
                X_2nd_RD_IN_H_1.tx[0] = EAST;
            } else {
                if (quotient_x_in_head % 2 == 0) {
                    X_2nd_RD_IN_H_0.rx = WEST;
                    X_2nd_RD_IN_H_0.tx[0] = RAMP;
                    X_2nd_RD_IN_H_1.rx = RAMP;
                    X_2nd_RD_IN_H_1.tx[0] = EAST;
                } else {
                    X_2nd_RD_IN_H_1.rx = WEST;
                    X_2nd_RD_IN_H_1.tx[0] = RAMP;
                    X_2nd_RD_IN_H_0.rx = RAMP;
                    X_2nd_RD_IN_H_0.tx[0] = EAST;
                }
            }
        } else if (remainder_x_in_head > root_px_in_head_1st_phase) {
            if (quotient_x_in_head % 2 == 0) {
                X_2nd_RD_IN_H_0.rx = RAMP;
                X_2nd_RD_IN_H_0.tx[0] = RAMP;
                X_2nd_RD_IN_H_1.rx = WEST;
                X_2nd_RD_IN_H_1.tx[0] = EAST;
            } else {
                X_2nd_RD_IN_H_0.rx = WEST;
                X_2nd_RD_IN_H_0.tx[0] = EAST;
                X_2nd_RD_IN_H_1.rx = RAMP;
                X_2nd_RD_IN_H_1.tx[0] = RAMP;
            }
        } else {
            if (quotient_x_in_head == 0) {
                // nothing to be relayed
                X_2nd_RD_IN_H_0.rx = RAMP;
                X_2nd_RD_IN_H_0.tx[0] = RAMP;
                X_2nd_RD_IN_H_1.rx = RAMP;
                X_2nd_RD_IN_H_1.tx[0] = RAMP;
            } else if (quotient_x_in_head % 2 == 0) {
                X_2nd_RD_IN_H_0.rx = WEST;
                X_2nd_RD_IN_H_0.tx[0] = EAST;
                X_2nd_RD_IN_H_1.rx = RAMP;
                X_2nd_RD_IN_H_1.tx[0] = RAMP;
            } else {
                X_2nd_RD_IN_H_0.rx = RAMP;
                X_2nd_RD_IN_H_0.tx[0] = RAMP;
                X_2nd_RD_IN_H_1.rx = WEST;
                X_2nd_RD_IN_H_1.tx[0] = EAST;
            }
        }
    } else {    // from EAST to WEST
        if (remainder_x_in_head == root_px_in_head_1st_phase) {
            if (px_in_head > pes_p_head - pe_num_p_last_group_in_head - 1) {
                if (quotient_x_in_head % 2 == 0) {
                    X_2nd_RD_IN_H_1.rx = RAMP;
                    X_2nd_RD_IN_H_1.tx[0] = RAMP;
                    X_2nd_RD_IN_H_0.rx = RAMP;
                    X_2nd_RD_IN_H_0.tx[0] = WEST;
                } else {
                    X_2nd_RD_IN_H_0.rx = RAMP;
                    X_2nd_RD_IN_H_0.tx[0] = RAMP;
                    X_2nd_RD_IN_H_1.rx = RAMP;
                    X_2nd_RD_IN_H_1.tx[0] = WEST;
                }
            } else {
                if (quotient_x_in_head % 2 == 0) {
                    X_2nd_RD_IN_H_1.rx = EAST;
                    X_2nd_RD_IN_H_1.tx[0] = RAMP;
                    X_2nd_RD_IN_H_0.rx = RAMP;
                    X_2nd_RD_IN_H_0.tx[0] = WEST;
                } else {
                    X_2nd_RD_IN_H_0.rx = EAST;
                    X_2nd_RD_IN_H_0.tx[0] = RAMP;
                    X_2nd_RD_IN_H_1.rx = RAMP;
                    X_2nd_RD_IN_H_1.tx[0] = WEST;
                }
            }
        } else if (remainder_x_in_head < root_px_in_head_1st_phase) {
            if (quotient_x_in_head % 2 == 0) {
                X_2nd_RD_IN_H_0.rx = EAST;
                X_2nd_RD_IN_H_0.tx[0] = WEST;
                X_2nd_RD_IN_H_1.rx = RAMP;
                X_2nd_RD_IN_H_1.tx[0] = RAMP;
            } else {
                X_2nd_RD_IN_H_0.rx = RAMP;
                X_2nd_RD_IN_H_0.tx[0] = RAMP;
                X_2nd_RD_IN_H_1.rx = EAST;
                X_2nd_RD_IN_H_1.tx[0] = WEST;
            }
        } else {
            if (quotient_x_in_head == eff_gnum_xh - 1) {
                // nothing to be relayed
                X_2nd_RD_IN_H_0.rx = RAMP;
                X_2nd_RD_IN_H_0.tx[0] = RAMP;
                X_2nd_RD_IN_H_1.rx = RAMP;
                X_2nd_RD_IN_H_1.tx[0] = RAMP;
            } else if (quotient_x_in_head % 2 == 0) {
                X_2nd_RD_IN_H_0.rx = RAMP;
                X_2nd_RD_IN_H_0.tx[0] = RAMP;
                X_2nd_RD_IN_H_1.rx = EAST;
                X_2nd_RD_IN_H_1.tx[0] = WEST;
            } else {
                X_2nd_RD_IN_H_0.rx = EAST;
                X_2nd_RD_IN_H_0.tx[0] = WEST;
                X_2nd_RD_IN_H_1.rx = RAMP;
                X_2nd_RD_IN_H_1.tx[0] = RAMP;
            }
        }
    }

    // general attention block
    if (px == root_px_2nd_phase) {
        X_BD_.rx = RAMP;
        X_BD_.tx[0] = WEST;
        X_BD_.tx[1] = EAST;
        X_BD_.tx_cnt = 2;
     } else if (px < root_px_2nd_phase) {
        if (px == 0) {
            X_BD_ht.rx = EAST;
            X_BD_ht.tx[0] = RAMP;
            X_BD_ht.tx[1] = RAMP;
            X_BD_ht.tx_cnt = 1;
        } else {
            X_BD_.rx = EAST;
            X_BD_.tx[0] = WEST;
            X_BD_.tx[1] = RAMP;
            X_BD_.tx_cnt = 2;
        }
    } else {
        // px > root_2nd_phase
        if (px == Pw - 1) {
            X_BD_ht.rx = WEST;
            X_BD_ht.tx[0] = RAMP;
            X_BD_ht.tx[1] = RAMP;
            X_BD_ht.tx_cnt = 1;
        } else {
            X_BD_.rx = WEST;
            X_BD_.tx[0] = RAMP;
            X_BD_.tx[1] = EAST;
            X_BD_.tx_cnt = 2;
        }
    }

    if (py == root_py_2nd_phase) {
        Y_BD_.rx = RAMP;
        Y_BD_.tx[0] = NORTH;
        Y_BD_.tx[1] = SOUTH;
        Y_BD_.tx_cnt = 2;
    } else if (py < root_py_2nd_phase) {
        if (py == 0) {
            Y_BD_ht.rx = SOUTH;
            Y_BD_ht.tx[0] = RAMP;
            Y_BD_ht.tx[1] = RAMP;
            Y_BD_ht.tx_cnt = 1;
        } else {
            Y_BD_.rx = SOUTH;
            Y_BD_.tx[0] = NORTH;
            Y_BD_.tx[1] = RAMP;
            Y_BD_.tx_cnt = 2;
        }
    } else {
        // py > root_2nd_phase
        if (py == Ph - 1) {
            Y_BD_ht.rx = NORTH;
            Y_BD_ht.tx[0] = RAMP;
            Y_BD_ht.tx[1] = RAMP;
            Y_BD_ht.tx_cnt = 1;
        } else {
            Y_BD_.rx = NORTH;
            Y_BD_.tx[0] = RAMP;
            Y_BD_.tx[1] = SOUTH;
            Y_BD_.tx_cnt = 2;
        }
    }

    // multi-head attention
    if (px_in_head == root_px_in_head_2nd_phase) {
        X_BD_IN_H_.rx = RAMP;
        X_BD_IN_H_.tx[0] = WEST;
        X_BD_IN_H_.tx[1] = EAST;
        X_BD_IN_H_.tx_cnt = 2;
        X_BD_ht_IN_H.rx = RAMP;
        X_BD_ht_IN_H.tx[0] = WEST;
        X_BD_ht_IN_H.tx[1] = RAMP;
        X_BD_ht_IN_H.tx_cnt = 1;
    } else if (px_in_head < root_px_in_head_2nd_phase) {
        if (px_in_head == 0) {
            X_BD_ht_IN_H.rx = EAST;
            X_BD_ht_IN_H.tx[0] = RAMP;
            X_BD_ht_IN_H.tx[1] = RAMP;
            X_BD_ht_IN_H.tx_cnt = 1;
        } else {
            X_BD_IN_H_.rx = EAST;
            X_BD_IN_H_.tx[0] = WEST;
            X_BD_IN_H_.tx[1] = RAMP;
            X_BD_IN_H_.tx_cnt = 2;
        }
    } else {
        // px_in_head > eff_root_2nd_xh
        if (px_in_head == pes_p_head - 1) {
            X_BD_ht_IN_H.rx = WEST;
            X_BD_ht_IN_H.tx[0] = RAMP;
            X_BD_ht_IN_H.tx[1] = RAMP;
            X_BD_ht_IN_H.tx_cnt = 1;
        } else {
            X_BD_IN_H_.rx = WEST;
            X_BD_IN_H_.tx[0] = RAMP;
            X_BD_IN_H_.tx[1] = EAST;
            X_BD_IN_H_.tx_cnt = 2;
        }
    }

    X_BD = if (px == 0 or px == Pw - 1) X_BD_ht else X_BD_;
    Y_BD = if (py == 0 or py == Ph - 1) Y_BD_ht else Y_BD_;
    X_BD_IN_H = if (px_in_head == 0 or px_in_head == pes_p_head - 1) X_BD_ht_IN_H else X_BD_IN_H_;
}

fn init(
    px: i16, 
    quotient_x: i16, 
    remainder_x: i16, 
    py: i16, 
    quotient_y: i16, 
    remainder_y: i16,
    px_in_head: i16,
    quotient_x_in_head: i16,
    remainder_x_in_head: i16,
    _pe_num_p_h_group: i16, 
    _pe_num_p_v_group: i16,
    _root_px_1st_phase: i16,
    _root_px_2nd_phase: i16,
    _root_py_1st_phase: i16,
    _root_py_2nd_phase: i16,
    _pe_num_p_group_in_head: i16,
    _root_px_in_head_1st_phase: i16,
    _root_px_in_head_2nd_phase: i16,
) void {
    // calculation
    pe_num_p_h_group = _pe_num_p_h_group;
    pe_num_p_v_group = _pe_num_p_v_group;
    root_px_1st_phase = _root_px_1st_phase;
    root_px_2nd_phase = _root_px_2nd_phase;
    root_py_1st_phase = _root_py_1st_phase;
    root_py_2nd_phase = _root_py_2nd_phase;
    pe_num_p_group_in_head = _pe_num_p_group_in_head;
    root_px_in_head_1st_phase = _root_px_in_head_1st_phase;
    root_px_in_head_2nd_phase = _root_px_in_head_2nd_phase;

    // ================================================================ //
    // Compute effective per-PE root values (supports fractional groups) //
    // ================================================================ //

    // --- X direction (general attention) ---
    const h_group_num: i16 = Pw / pe_num_p_first_h_group;
    const h_rem: i16 = Pw - h_group_num * pe_num_p_first_h_group;
    eff_gnum_x = h_group_num + (if (h_rem > 0) @as(i16, 1) else @as(i16, 0));

    // --- Y direction (general attention) ---
    const v_group_num: i16 = Ph / pe_num_p_first_v_group;
    const v_rem: i16 = Ph - v_group_num * pe_num_p_first_v_group;
    eff_gnum_y = v_group_num + (if (v_rem > 0) @as(i16, 1) else @as(i16, 0));

    // --- X direction (in-head, multi-head attention) ---
    const group_num_in_head: i16 = pes_p_head / pe_num_p_first_group_in_head;
    const head_rem: i16 = pes_p_head - group_num_in_head * pe_num_p_first_group_in_head;
    eff_gnum_xh = group_num_in_head + (if (head_rem > 0) @as(i16, 1) else @as(i16, 0));

    get_params(px, quotient_x, remainder_x, py, quotient_y, remainder_y, px_in_head, quotient_x_in_head, remainder_x_in_head);

    // ================================================================ //
    // Categorize PE into a type    //
    // ================================================================ //
    // type in a horizontal all-reduce (1st phase)
    if (remainder_x == root_px_1st_phase) {
        if (root_px_1st_phase < pe_num_p_h_group - 1) {
            X_1st_pe_type = 0;
        }
        else {
            X_1st_pe_type = 1;
        }
    } else if (remainder_x > root_px_1st_phase) {
        if (remainder_x % 2 == 0) {
            if (remainder_x == pe_num_p_h_group - 1) { 
                X_1st_pe_type = 2;
            } else {
                X_1st_pe_type = 3;
            }
        } else {
            // remainder_x % 2 == 1
            if (remainder_x == pe_num_p_h_group - 1) {
                X_1st_pe_type = 4;
            } else {
                X_1st_pe_type = 5;
            }
        }
    } else {
        // remainder_x < root_1st_phase
        if (remainder_x % 2 == 0) {
            if (remainder_x == 0) {
                X_1st_pe_type = 4;
            } else {
                X_1st_pe_type = 5;
            }
        } else {
            // remainder_x never be 0
            X_1st_pe_type = 3;
        }
    }

    // type in a horizontal all-reduce (2nd phase)
    if (px == root_px_2nd_phase) {
        if (root_px_2nd_phase < Pw - pe_num_p_last_h_group) {
            X_2nd_pe_type = 0;
        }
        else {
            X_2nd_pe_type = 1;
        }
    } else if (px > root_px_2nd_phase) {
        if (remainder_x == root_px_1st_phase) {
            if (px > Pw - pe_num_p_last_h_group - 1) {
                if (quotient_x % 2 == 0) {
                    X_2nd_pe_type = 2;
                } else {
                    X_2nd_pe_type = 3;
                }
            } else {
                if (quotient_x % 2 == 0) {
                    X_2nd_pe_type = 4;
                } else {
                    X_2nd_pe_type = 5;
                }
            }
        }
        else if (remainder_x < root_px_1st_phase) {
            if (quotient_x % 2 == 0) {
                // reduce_2nd_color_0 is already managed
                X_2nd_pe_type = 6;
            } else {
                // reduce_2nd_color_1 is already managed
                X_2nd_pe_type = 7;
            }
        } else {
            // remainder_x > root_1st_phase
            if (quotient_x == eff_gnum_x - 1) {
                // relay nothing = teardown both
                X_2nd_pe_type = 8;
            } else if (quotient_x % 2 == 0) {
                // reduce_2nd_color_1 is already managed
                X_2nd_pe_type = 7;
            } else {
                // reduce_2nd_color_0 is already managed
                X_2nd_pe_type = 6;
            }
        }
    } else {
        if (remainder_x == root_px_1st_phase) {
            if (px < pe_num_p_h_group) {
                X_2nd_pe_type = 3;
            } else {
                if (quotient_x % 2 == 0) {
                    X_2nd_pe_type = 5;
                } else {
                    X_2nd_pe_type = 4;
                }
            }
        }
        else if (remainder_x > root_px_1st_phase) {
            if (quotient_x % 2 == 0) {
                // reduce_2nd_color_1 is already managed
                X_2nd_pe_type = 7;
            } else {
                // reduce_2nd_color_0 is already managed
                X_2nd_pe_type = 6;
            }
        } else {
            if (quotient_x == 0) {
                // relay nothing = teardown both
                X_2nd_pe_type = 8;
            } else if (quotient_x % 2 == 0) {
                // reduce_2nd_color_0 is already managed
                X_2nd_pe_type = 6;
            } else {
                // reduce_2nd_color_1 is already managed
                X_2nd_pe_type = 7;
            }
        }
    }

    // type in a horizontal all-reduce
    if (X_1st_pe_type <= 1) {
        if (X_2nd_pe_type <= 1) {
            X_reduce_pe_type = X_1st_pe_type * 2 + X_2nd_pe_type;            // 0..3
        } else {
            X_reduce_pe_type = 4 + X_1st_pe_type * 4 + (X_2nd_pe_type - 2); // 4..11
        }
    } else {
        X_reduce_pe_type = 12 + (X_1st_pe_type - 2) * 3 + (X_2nd_pe_type - 6); // 12..23
    }

    // type in a horizontal all-reduce (broadcast)
    if (px == root_px_2nd_phase) {
        X_bdcast_pe_type = 0;
    } else {
        X_bdcast_pe_type = 1;
    }

    // type in a vertical all-reduce (1st phase)
    if (remainder_y == root_py_1st_phase) {
        if (root_py_1st_phase < pe_num_p_v_group - 1) {
            Y_1st_pe_type = 0;
        }
        else {
            Y_1st_pe_type = 1;
        }
    } else if (remainder_y > root_py_1st_phase) {
        if (remainder_y % 2 == 0) {
            if (remainder_y == pe_num_p_v_group - 1) { 
                Y_1st_pe_type = 2;
            } else {
                Y_1st_pe_type = 3;
            }
        } else {
            // remainder_y % 2 == 1
            if (remainder_y == pe_num_p_v_group - 1) {
                Y_1st_pe_type = 4;
            } else {
                Y_1st_pe_type = 5;
            }
        }
    } else {
        // remainder_y < root_1st_phase
        if (remainder_y % 2 == 0) {
            if (remainder_y == 0) {
                Y_1st_pe_type = 4;
            } else {
                Y_1st_pe_type = 5;
            }
        } else {
            // remainder_y never be 0
            Y_1st_pe_type = 3;
        }
    }

    // type in a vertical all-reduce (2nd phase)
    if (py == root_py_2nd_phase) {
        if (root_py_2nd_phase < Ph - pe_num_p_last_v_group) {
            Y_2nd_pe_type = 0;
        }
        else {
            Y_2nd_pe_type = 1;
        }
    } else if (py > root_py_2nd_phase) {
        if (remainder_y == root_py_1st_phase) {
            if (py > Ph - pe_num_p_last_v_group - 1) {
                if (quotient_y % 2 == 0) {
                    Y_2nd_pe_type = 2;
                } else {
                    Y_2nd_pe_type = 3;
                }
            } else {
                if (quotient_y % 2 == 0) {
                    Y_2nd_pe_type = 4;
                } else {
                    Y_2nd_pe_type = 5;
                }
            }
        }
        else if (remainder_y < root_py_1st_phase) {
            if (quotient_y % 2 == 0) {
                // reduce_2nd_color_0 is already managed
                Y_2nd_pe_type = 6;
            } else {
                // reduce_2nd_color_1 is already managed
                Y_2nd_pe_type = 7;
            }
        } else {
            // remainder_y > root_1st_phase
            if (quotient_y == eff_gnum_y - 1) {
                // relay nothing = teardown both
                Y_2nd_pe_type = 8;
            } else if (quotient_y % 2 == 0) {
                // reduce_2nd_color_1 is already managed
                Y_2nd_pe_type = 7;
            } else {
                // reduce_2nd_color_0 is already managed
                Y_2nd_pe_type = 6;
            }
        }
    } else {
        if (remainder_y == root_py_1st_phase) {
            if (py < pe_num_p_v_group) {
                Y_2nd_pe_type = 3;
            } else {
                if (quotient_y % 2 == 0) {
                    Y_2nd_pe_type = 5;
                } else {
                    Y_2nd_pe_type = 4;
                }
            }
        }
        else if (remainder_y > root_py_1st_phase) {
            if (quotient_y % 2 == 0) {
                // reduce_2nd_color_1 is already managed
                Y_2nd_pe_type = 7;
            } else {
                // reduce_2nd_color_0 is already managed
                Y_2nd_pe_type = 6;
            }
        } else {
            if (quotient_y == 0) {
                // relay nothing = teardown both
                Y_2nd_pe_type = 8;
            } else if (quotient_y % 2 == 0) {
                // reduce_2nd_color_0 is already managed
                Y_2nd_pe_type = 6;
            } else {
                // reduce_2nd_color_1 is already managed
                Y_2nd_pe_type = 7;
            }
        }
    }

    // type in a vertical all-reduce
    if (Y_1st_pe_type <= 1) {
        if (Y_2nd_pe_type <= 1) {
            Y_reduce_pe_type = Y_1st_pe_type * 2 + Y_2nd_pe_type;            // 0..3
        } else {
            Y_reduce_pe_type = 4 + Y_1st_pe_type * 4 + (Y_2nd_pe_type - 2); // 4..11
        }
    } else {
        Y_reduce_pe_type = 12 + (Y_1st_pe_type - 2) * 3 + (Y_2nd_pe_type - 6); // 12..23
    }

    // type in a vertical all-reduce (broadcast)
    if (py == root_py_2nd_phase) {
        Y_bdcast_pe_type = 0;
    } else {
        Y_bdcast_pe_type = 1;
    }

    // type in a horizontal all-reduce in head (1st phase)
    if (remainder_x_in_head == root_px_in_head_1st_phase) {
        if (root_px_in_head_1st_phase < pe_num_p_group_in_head - 1) { 
            XH_1st_pe_type = 0; 
        } else {
            XH_1st_pe_type = 1;
        }
    } else if (remainder_x_in_head > root_px_in_head_1st_phase) {
        if (remainder_x_in_head % 2 == 0) {
            if (remainder_x_in_head == pe_num_p_group_in_head - 1) { 
                XH_1st_pe_type = 2; 
            } else { 
                XH_1st_pe_type = 3; 
            }
        } else {
            if (remainder_x_in_head == pe_num_p_group_in_head - 1) { 
                XH_1st_pe_type = 4; 
            } else {
                XH_1st_pe_type = 5;
            }
        }
    } else {
        if (remainder_x_in_head % 2 == 0) {
            if (remainder_x_in_head == 0) { 
                XH_1st_pe_type = 4; 
            } else { 
                XH_1st_pe_type = 5;
            }
        } else {
            XH_1st_pe_type = 3;
        }
    }

    // type in a horizontal all-reduce in head (2nd phase)
    if (px_in_head == root_px_in_head_2nd_phase) {
        if (root_px_in_head_2nd_phase < pes_p_head - pe_num_p_last_group_in_head) {
            XH_2nd_pe_type = 0;
        } else {
            XH_2nd_pe_type = 1;
        }
    } else if (px_in_head > root_px_in_head_2nd_phase) {
        if (remainder_x_in_head == root_px_in_head_1st_phase) {
            if (px_in_head > pes_p_head - pe_num_p_last_group_in_head - 1) {
                if (quotient_x_in_head % 2 == 0) {
                    XH_2nd_pe_type = 2;
                } else {
                    XH_2nd_pe_type = 3;
                }
            } else {
                if (quotient_x_in_head % 2 == 0) {
                    XH_2nd_pe_type = 4;
                } else {
                    XH_2nd_pe_type = 5;
                }
            }
        } else if (remainder_x_in_head < root_px_in_head_1st_phase) {
            if (quotient_x_in_head % 2 == 0) {
                XH_2nd_pe_type = 6;
            } else {
                XH_2nd_pe_type = 7;
            }
        } else {
            // remainder_x_in_head > root_px_in_head_1st_phase
            if (quotient_x_in_head == eff_gnum_xh - 1) {
                XH_2nd_pe_type = 8;
            } else if (quotient_x_in_head % 2 == 0) {
                XH_2nd_pe_type = 7;
            } else {
                XH_2nd_pe_type = 6;
            }
        }
    } else {
        if (remainder_x_in_head == root_px_in_head_1st_phase) {
            if (px_in_head < pe_num_p_group_in_head) {
                XH_2nd_pe_type = 3;
            } else {
                if (quotient_x_in_head % 2 == 0) {
                    XH_2nd_pe_type = 5;
                } else {
                    XH_2nd_pe_type = 4;
                }
            }
        } else if (remainder_x_in_head > root_px_in_head_1st_phase) {
            if (quotient_x_in_head % 2 == 0) {
                XH_2nd_pe_type = 7;
            } else {
                XH_2nd_pe_type = 6;
            }
        } else {
            if (quotient_x_in_head == 0) {
                XH_2nd_pe_type = 8;
            } else if (quotient_x_in_head % 2 == 0) {
                XH_2nd_pe_type = 6;
            } else {
                XH_2nd_pe_type = 7;
            }
        }
    }

    // type in a horizontal all-reduce in head
    if (XH_1st_pe_type <= 1) {
        if (XH_2nd_pe_type <= 1) {
            XH_reduce_pe_type = XH_1st_pe_type * 2 + XH_2nd_pe_type;            // 0..3
        } else {
            XH_reduce_pe_type = 4 + XH_1st_pe_type * 4 + (XH_2nd_pe_type - 2); // 4..11
        }
    } else {
        XH_reduce_pe_type = 12 + (XH_1st_pe_type - 2) * 3 + (XH_2nd_pe_type - 6); // 12..23
    }

    // type in a horizontal all-reduce (broadcast)
    if (px_in_head == root_px_in_head_2nd_phase) {
        XH_bdcast_pe_type = 0;
    } else {
        XH_bdcast_pe_type = 1;
    }

    // -------------- in teardown mode at the beginning ---------------- //

    color_config.reset_rx_routes(reduce_1st_color_0, Y_1st_RD_0.rx);
    color_config.reset_tx_routes(reduce_1st_color_0, &Y_1st_RD_0.tx, 1);
    color_config.reset_rx_routes(reduce_1st_color_1, Y_1st_RD_1.rx);
    color_config.reset_tx_routes(reduce_1st_color_1, &Y_1st_RD_1.tx, 1);

    color_config.reset_rx_routes(reduce_2nd_color_0, Y_2nd_RD_0.rx);
    color_config.reset_tx_routes(reduce_2nd_color_0, &Y_2nd_RD_0.tx, 1);
    color_config.reset_rx_routes(reduce_2nd_color_1, Y_2nd_RD_1.rx);
    color_config.reset_tx_routes(reduce_2nd_color_1, &Y_2nd_RD_1.tx, 1);

    color_config.reset_rx_routes(broadcast_color, Y_BD.rx);
    color_config.reset_tx_routes(broadcast_color, &Y_BD.tx, Y_BD.tx_cnt);
    teardown.exit(reduce_1st_color_0);
    teardown.exit(reduce_1st_color_1);
    teardown.exit(reduce_2nd_color_0);
    teardown.exit(reduce_2nd_color_1);
    teardown.exit(broadcast_color);
}

fn runtime_setup() void {
    // load dsd to dsr (for fabric_dsd)
    // only size will be changed at each call
    @load_to_dsr(reduce_1st_0_send_dsr, reduce_1st_0_send);
    @load_to_dsr(reduce_1st_1_send_dsr, reduce_1st_1_send);
    @load_to_dsr(reduce_2nd_0_send_dsr, reduce_2nd_0_send);
    @load_to_dsr(reduce_2nd_1_send_dsr, reduce_2nd_1_send);
    @load_to_dsr(bdcast_send_dsr, bdcast_send);

    @load_to_dsr(reduce_1st_0_recv_dsr, reduce_1st_0_recv);
    @load_to_dsr(reduce_1st_1_recv_dsr, reduce_1st_1_recv);
    @load_to_dsr(reduce_2nd_0_recv_dsr, reduce_2nd_0_recv);
    @load_to_dsr(reduce_2nd_1_recv_dsr, reduce_2nd_1_recv);
    @load_to_dsr(bdcast_recv_dsr, bdcast_recv);

    @load_to_dsr(ctrl_1st_0_dsr, ctrl_1st_0);
    @load_to_dsr(ctrl_1st_1_dsr, ctrl_1st_1);
    @load_to_dsr(ctrl_2nd_0_dsr, ctrl_2nd_0);
    @load_to_dsr(ctrl_2nd_1_dsr, ctrl_2nd_1);
    @load_to_dsr(ctrl_bdcast_dsr, ctrl_bdcast);

    // memory dsd will be loaded to dsr at each call
    @load_to_dsr(ctrl_buf_dsr, ctrl_mem);
}

// ==================== helper fns for all_reduce_with_reset ====================
// Each case is isolated in its own function to prevent LLVM SimplifyCFG from
// merging basic blocks across cases and generating phi nodes for immarg operands.

fn reduce_reset_case_0() void {  // X_1st=0, X_2nd=0
    @faddh(vector_buf_ddsr, reduce_1st_0_recv_dsr, vector_buf_s1dsr);
    @faddh(vector_buf_ddsr, reduce_1st_1_recv_dsr, vector_buf_s1dsr);
    @faddh(vector_buf_ddsr, reduce_2nd_0_recv_dsr, vector_buf_s1dsr);
    @faddh(vector_buf_ddsr, reduce_2nd_1_recv_dsr, vector_buf_s1dsr);
}
fn reduce_reset_case_1() void {  // X_1st=0, X_2nd=1
    @faddh(vector_buf_ddsr, reduce_1st_0_recv_dsr, vector_buf_s1dsr);
    @faddh(vector_buf_ddsr, reduce_1st_1_recv_dsr, vector_buf_s1dsr);
    @mov32(ctrl_2nd_0_dsr, ctrl_buf_dsr);
    @faddh(vector_buf_ddsr, reduce_2nd_1_recv_dsr, vector_buf_s1dsr);
}
fn reduce_reset_case_2() void {  // X_1st=1, X_2nd=0
    @mov32(ctrl_1st_0_dsr, ctrl_buf_dsr);
    @faddh(vector_buf_ddsr, reduce_1st_1_recv_dsr, vector_buf_s1dsr);
    @faddh(vector_buf_ddsr, reduce_2nd_0_recv_dsr, vector_buf_s1dsr);
    @faddh(vector_buf_ddsr, reduce_2nd_1_recv_dsr, vector_buf_s1dsr);
}
fn reduce_reset_case_3() void {  // X_1st=1, X_2nd=1
    @mov32(ctrl_1st_0_dsr, ctrl_buf_dsr);
    @faddh(vector_buf_ddsr, reduce_1st_1_recv_dsr, vector_buf_s1dsr);
    @mov32(ctrl_2nd_0_dsr, ctrl_buf_dsr);
    @faddh(vector_buf_ddsr, reduce_2nd_1_recv_dsr, vector_buf_s1dsr);
}
fn reduce_reset_case_4() void {  // X_1st=0, X_2nd=2
    @faddh(vector_buf_ddsr, reduce_1st_0_recv_dsr, vector_buf_s1dsr);
    // @faddh(vector_buf_ddsr, reduce_1st_1_recv_dsr, vector_buf_s1dsr);
    // @fmovh(reduce_2nd_0_send_dsr, vector_buf_s1dsr);    // TODO: merge this into the previous faddh
    @faddh(reduce_2nd_0_send_dsr, reduce_1st_1_recv_dsr, vector_buf_s1dsr);
    @mov32(ctrl_2nd_0_dsr, ctrl_buf_dsr);
    @mov32(ctrl_2nd_1_dsr, ctrl_buf_dsr);
}
fn reduce_reset_case_5() void {  // X_1st=0, X_2nd=3
    @faddh(vector_buf_ddsr, reduce_1st_0_recv_dsr, vector_buf_s1dsr);
    // @faddh(vector_buf_ddsr, reduce_1st_1_recv_dsr, vector_buf_s1dsr);
    // @fmovh(reduce_2nd_1_send_dsr, vector_buf_s1dsr);    // TODO: merge this into the previous faddh
    @faddh(reduce_2nd_1_send_dsr, reduce_1st_1_recv_dsr, vector_buf_s1dsr);
