fn all_reduce_without_reset(size: u16, vector_buf_ptr: [*]f16, c_axis: comm_axis, is_max: bool) void {
    @set_dsr_length(reduce_1st_0_send_dsr, size);
    @set_dsr_length(reduce_1st_1_send_dsr, size);
    @set_dsr_length(reduce_2nd_0_send_dsr, size);
    @set_dsr_length(reduce_2nd_1_send_dsr, size);
    @set_dsr_length(bdcast_send_dsr, size);

    @set_dsr_length(reduce_1st_0_recv_dsr, size);
    @set_dsr_length(reduce_1st_1_recv_dsr, size);
    @set_dsr_length(reduce_2nd_0_recv_dsr, size);
    @set_dsr_length(reduce_2nd_1_recv_dsr, size);
    @set_dsr_length(bdcast_recv_dsr, size);

    vector_buf_dsd = @set_dsd_length(vector_buf_dsd, size);
    vector_buf_dsd = @set_dsd_base_addr(vector_buf_dsd, vector_buf_ptr);
    @load_to_dsr(vector_buf_ddsr, vector_buf_dsd);
    @load_to_dsr(vector_buf_s1dsr, vector_buf_dsd);

    switch (c_axis) {
        comm_axis.horizontal => {
            reduce_pe_type = X_reduce_pe_type;
            bdcast_pe_type = X_bdcast_pe_type;
        },
        comm_axis.vertical => {
            reduce_pe_type = Y_reduce_pe_type;
            bdcast_pe_type = Y_bdcast_pe_type;
        },
        comm_axis.horizontal_in_head => {
            reduce_pe_type = XH_reduce_pe_type;
            bdcast_pe_type = XH_bdcast_pe_type;
        },
    }

    // switch (reduce_pe_type) {
    //     // ==================== Group A: absolute root ====================
    //     0 => {  // X_1st=0, X_2nd=0: 1st recv both, 2nd recv from both
    //         // @faddh(vector_buf_ddsr, reduce_1st_0_recv_dsr, vector_buf_s1dsr);
    //         // @faddh(vector_buf_ddsr, reduce_1st_1_recv_dsr, vector_buf_s1dsr);
    //         // @faddh(vector_buf_ddsr, reduce_2nd_0_recv_dsr, vector_buf_s1dsr);
    //         // @faddh(vector_buf_ddsr, reduce_2nd_1_recv_dsr, vector_buf_s1dsr);
    //         reduce_noreset_case_0();
    //     },
    //     1 => {  // X_1st=0, X_2nd=1: 1st recv both, 2nd recv from head sides (i.e., it is tail group)
    //         // @faddh(vector_buf_ddsr, reduce_1st_0_recv_dsr, vector_buf_s1dsr);
    //         // @faddh(vector_buf_ddsr, reduce_1st_1_recv_dsr, vector_buf_s1dsr);
    //         // @faddh(vector_buf_ddsr, reduce_2nd_1_recv_dsr, vector_buf_s1dsr);
    //         reduce_noreset_case_1();
    //     },
    //     2 => {  // X_1st=1, X_2nd=0: 1st only from top (end of the group), 2nd recv both sides
    //         // @faddh(vector_buf_ddsr, reduce_1st_1_recv_dsr, vector_buf_s1dsr);
    //         // @faddh(vector_buf_ddsr, reduce_2nd_0_recv_dsr, vector_buf_s1dsr);
    //         // @faddh(vector_buf_ddsr, reduce_2nd_1_recv_dsr, vector_buf_s1dsr);
    //         reduce_noreset_case_2();
    //     },
    //     3 => {  // X_1st=1, X_2nd=1: 1st only from top, 2nd only from head sides (i.e., it is tail group)
    //         // @faddh(vector_buf_ddsr, reduce_1st_1_recv_dsr, vector_buf_s1dsr);
    //         // @faddh(vector_buf_ddsr, reduce_2nd_1_recv_dsr, vector_buf_s1dsr);
    //         reduce_noreset_case_3();
    //     },
    //     // ==================== Group B: 1st root, 2nd relay ====================
    //     4 => {  // X_1st=0, X_2nd=2: 1st recv both, 2nd fmovh→send_0 (root of tail group; even)
    //         // @faddh(vector_buf_ddsr, reduce_1st_0_recv_dsr, vector_buf_s1dsr);
    //         // @faddh(vector_buf_ddsr, reduce_1st_1_recv_dsr, vector_buf_s1dsr);
    //         // @fmovh(reduce_2nd_0_send_dsr, vector_buf_s1dsr);    // TODO: merge this into the previous faddh
    //         reduce_noreset_case_4();
    //     },
    //     5 => {  // X_1st=0, X_2nd=3: 1st recv both, 2nd fmovh→send_1 (root of head group, or root of tail group; odd)
    //         // @faddh(vector_buf_ddsr, reduce_1st_0_recv_dsr, vector_buf_s1dsr);
    //         // @faddh(vector_buf_ddsr, reduce_1st_1_recv_dsr, vector_buf_s1dsr);
    //         // @fmovh(reduce_2nd_1_send_dsr, vector_buf_s1dsr);    // TODO: merge this into the previous faddh
    //         reduce_noreset_case_5();
    //     },
    //     6 => {  // X_1st=0, X_2nd=4: 1st recv both, 2nd faddh→send_0
    //         // @faddh(vector_buf_ddsr, reduce_1st_0_recv_dsr, vector_buf_s1dsr);
    //         // @faddh(vector_buf_ddsr, reduce_1st_1_recv_dsr, vector_buf_s1dsr);
    //         // @faddh(reduce_2nd_0_send_dsr, reduce_2nd_1_recv_dsr, vector_buf_s1dsr);
    //         reduce_noreset_case_6();
    //     },
    //     7 => {  // X_1st=0, X_2nd=5: 1st recv both, 2nd faddh→send_1
    //         // @faddh(vector_buf_ddsr, reduce_1st_0_recv_dsr, vector_buf_s1dsr);
    //         // @faddh(vector_buf_ddsr, reduce_1st_1_recv_dsr, vector_buf_s1dsr);
    //         // @faddh(reduce_2nd_1_send_dsr, reduce_2nd_0_recv_dsr, vector_buf_s1dsr);
    //         reduce_noreset_case_7();
    //     },
    //     8 => {  // X_1st=1, X_2nd=2
    //         // @faddh(vector_buf_ddsr, reduce_1st_1_recv_dsr, vector_buf_s1dsr);
    //         // @fmovh(reduce_2nd_0_send_dsr, vector_buf_s1dsr);    // TODO: merge this into the previous faddh
    //         reduce_noreset_case_8();
    //     },
    //     9 => {  // X_1st=1, X_2nd=3
    //         // @faddh(vector_buf_ddsr, reduce_1st_1_recv_dsr, vector_buf_s1dsr);
    //         // @fmovh(reduce_2nd_1_send_dsr, vector_buf_s1dsr);    // TODO: merge this into the previous faddh
    //         reduce_noreset_case_9();
    //     },
    //     10 => {  // X_1st=1, X_2nd=4
    //         // @faddh(vector_buf_ddsr, reduce_1st_1_recv_dsr, vector_buf_s1dsr);
    //         // @faddh(reduce_2nd_0_send_dsr, reduce_2nd_1_recv_dsr, vector_buf_s1dsr);
    //         reduce_noreset_case_10();
    //     },
    //     11 => {  // X_1st=1, X_2nd=5
    //         // @faddh(vector_buf_ddsr, reduce_1st_1_recv_dsr, vector_buf_s1dsr);
    //         // @faddh(reduce_2nd_1_send_dsr, reduce_2nd_0_recv_dsr, vector_buf_s1dsr);
    //         reduce_noreset_case_11();
    //     },
    //     // ==================== Group C: non-root (1st data op + 2nd teardown) ====================
    //     12, 13, 14 => {  // X_1st=2, X_2nd=6/7/8
    //         // @fmovh(reduce_1st_0_send_dsr, vector_buf_s1dsr);
    //         reduce_noreset_case_12_13_14();
    //     },
    //     15, 16, 17 => {  // X_1st=3, X_2nd=6/7/8
    //         // @faddh(reduce_1st_0_send_dsr, reduce_1st_1_recv_dsr, vector_buf_s1dsr);
    //         reduce_noreset_case_15_16_17();
    //     },
    //     18, 19, 20 => {  // X_1st=4, X_2nd=6/7/8
    //         // @fmovh(reduce_1st_1_send_dsr, vector_buf_s1dsr);
    //         reduce_noreset_case_18_19_20();
    //     },
    //     21, 22, 23 => {  // X_1st=5, X_2nd=6/7/8
    //         // @faddh(reduce_1st_1_send_dsr, reduce_1st_0_recv_dsr, vector_buf_s1dsr);
    //         reduce_noreset_case_21_22_23();
    //     },
    //     else => {},
    // }
    // const func_to_call: *const fn() void = reduce_noreset_funcs[reduce_pe_type];
    // func_to_call();
    if (is_max) {
        reduceMax_noreset_funcs[reduce_pe_type]();
    } else {
        reduce_noreset_funcs[reduce_pe_type]();
    }
    // reduce_noreset_funcs[reduce_pe_type]();

    if (bdcast_pe_type == 0) {
        @mov16(bdcast_send_dsr, vector_buf_s1dsr);
    } else {
        @mov16(vector_buf_ddsr, bdcast_recv_dsr);
    }

    @block(reduce_1st_0_recv_queue_id);
    @block(reduce_1st_1_recv_queue_id);
    @block(reduce_2nd_0_recv_queue_id);
    @block(reduce_2nd_1_recv_queue_id);
    @block(broadcast_recv_queue_id);
}

fn reconfig_allreduce_axis(axis: i16, is_in_head: bool) void {
    // confirm all wavelets in output queue are already sent
    var cnt: u16 = 0;    // endless loop prevention
    var status = output_queue_status.get();
    while (status.empty != @as(u8, 255) and cnt < 500) {
        status = output_queue_status.get();
        cnt += 1;
    }
    // simprint.fmt_with_coords("print: output_queue is now empty (cnt={d})!\n", .{@as(u16, cnt)});

    while ((is_in_teardown(reduce_1st_color_0) and is_in_teardown(reduce_1st_color_1) and is_in_teardown(reduce_2nd_color_0) and is_in_teardown(reduce_2nd_color_1) and is_in_teardown(broadcast_color)) == false) {
        cnt += 1;
        if (cnt > 1000) {
            // simprint.fmt_with_coords("print: some colors are still not in teardown (cnt={d})!\n", .{@as(u16, cnt)});
            if ((is_in_teardown(reduce_1st_color_0)) == false) {
                simprint.fmt_with_coords("print: 1st_color_0 is still not in teardown (cnt={d})!\n", .{@as(u16, cnt)});
            }
            if ((is_in_teardown(reduce_1st_color_1)) == false) {
                simprint.fmt_with_coords("print: 1st_color_1 is still not in teardown (cnt={d})!\n", .{@as(u16, cnt)});
            }
            if ((is_in_teardown(reduce_2nd_color_0)) == false) {
                simprint.fmt_with_coords("print: 2nd_color_0 is still not in teardown (cnt={d})!\n", .{@as(u16, cnt)});
            }
            if ((is_in_teardown(reduce_2nd_color_1)) == false) {
                simprint.fmt_with_coords("print: 2nd_color_1 is still not in teardown (cnt={d})!\n", .{@as(u16, cnt)});
            }
            if ((is_in_teardown(broadcast_color)) == false) {
                simprint.fmt_with_coords("print: broadcast_color is still not in teardown (cnt={d})!\n", .{@as(u16, cnt)});
            }
            break;
        }
    }
    if (is_in_head and axis == 0) {
        // Allreduce along X axis in each attention head
        color_config.reset_rx_routes(reduce_1st_color_0, X_1st_RD_IN_H_0.rx);
        color_config.reset_tx_routes(reduce_1st_color_0, &X_1st_RD_IN_H_0.tx, 1);
        color_config.reset_rx_routes(reduce_1st_color_1, X_1st_RD_IN_H_1.rx);
        color_config.reset_tx_routes(reduce_1st_color_1, &X_1st_RD_IN_H_1.tx, 1);
        color_config.reset_rx_routes(reduce_2nd_color_0, X_2nd_RD_IN_H_0.rx);
        color_config.reset_tx_routes(reduce_2nd_color_0, &X_2nd_RD_IN_H_0.tx, 1);
        color_config.reset_rx_routes(reduce_2nd_color_1, X_2nd_RD_IN_H_1.rx);
        color_config.reset_tx_routes(reduce_2nd_color_1, &X_2nd_RD_IN_H_1.tx, 1);
        color_config.reset_rx_routes(broadcast_color, X_BD_IN_H.rx);
        color_config.reset_tx_routes(broadcast_color, &X_BD_IN_H.tx, X_BD_IN_H.tx_cnt);

    } else if (axis == 0) {
        // Allreduce along X axis
        color_config.reset_rx_routes(reduce_1st_color_0, X_1st_RD_0.rx);
        color_config.reset_tx_routes(reduce_1st_color_0, &X_1st_RD_0.tx, 1);
        color_config.reset_rx_routes(reduce_1st_color_1, X_1st_RD_1.rx);
        color_config.reset_tx_routes(reduce_1st_color_1, &X_1st_RD_1.tx, 1);
        color_config.reset_rx_routes(reduce_2nd_color_0, X_2nd_RD_0.rx);
        color_config.reset_tx_routes(reduce_2nd_color_0, &X_2nd_RD_0.tx, 1);
        color_config.reset_rx_routes(reduce_2nd_color_1, X_2nd_RD_1.rx);
        color_config.reset_tx_routes(reduce_2nd_color_1, &X_2nd_RD_1.tx, 1);
        color_config.reset_rx_routes(broadcast_color, X_BD.rx);
        color_config.reset_tx_routes(broadcast_color, &X_BD.tx, X_BD.tx_cnt);

    } else if (axis == 1) {
        // Allreduce along Y axis
        color_config.reset_rx_routes(reduce_1st_color_0, Y_1st_RD_0.rx);
        color_config.reset_tx_routes(reduce_1st_color_0, &Y_1st_RD_0.tx, 1);
        color_config.reset_rx_routes(reduce_1st_color_1, Y_1st_RD_1.rx);
        color_config.reset_tx_routes(reduce_1st_color_1, &Y_1st_RD_1.tx, 1);
        color_config.reset_rx_routes(reduce_2nd_color_0, Y_2nd_RD_0.rx);
        color_config.reset_tx_routes(reduce_2nd_color_0, &Y_2nd_RD_0.tx, 1);
        color_config.reset_rx_routes(reduce_2nd_color_1, Y_2nd_RD_1.rx);
        color_config.reset_tx_routes(reduce_2nd_color_1, &Y_2nd_RD_1.tx, 1);
        color_config.reset_rx_routes(broadcast_color, Y_BD.rx);
        color_config.reset_tx_routes(broadcast_color, &Y_BD.tx, Y_BD.tx_cnt);

    } else {
        @assert(false);
    }
    teardown_exit(reduce_1st_color_0);
    teardown_exit(reduce_1st_color_1);
    teardown_exit(reduce_2nd_color_0);
    teardown_exit(reduce_2nd_color_1);
    teardown_exit(broadcast_color);
}

comptime {

    if (@is_arch("wse3")) {
        @initialize_queue(broadcast_send_queue_id, .{ .color = broadcast_color });
        @initialize_queue(broadcast_recv_queue_id, .{ .color = broadcast_color });

        @initialize_queue(reduce_1st_0_recv_queue_id, .{ .color = reduce_1st_color_0 });
        @initialize_queue(reduce_1st_0_send_queue_id, .{ .color = reduce_1st_color_0 });
        @initialize_queue(reduce_1st_1_recv_queue_id, .{ .color = reduce_1st_color_1 });
        @initialize_queue(reduce_1st_1_send_queue_id, .{ .color = reduce_1st_color_1 });

        @initialize_queue(reduce_2nd_0_recv_queue_id, .{ .color = reduce_2nd_color_0 });
        @initialize_queue(reduce_2nd_0_send_queue_id, .{ .color = reduce_2nd_color_0 });
        @initialize_queue(reduce_2nd_1_recv_queue_id, .{ .color = reduce_2nd_color_1 });
        @initialize_queue(reduce_2nd_1_send_queue_id, .{ .color = reduce_2nd_color_1 });
    }
}


comptime {
    @set_local_color_config(reduce_1st_color_0, .{
        .routes = .{},
        .teardown = true,
    });
    @set_local_color_config(reduce_1st_color_1, .{
        .routes = .{},
        .teardown = true,
    });
    @set_local_color_config(reduce_2nd_color_0, .{
        .routes = .{},
        .teardown = true,
    });
    @set_local_color_config(reduce_2nd_color_1, .{
        .routes = .{},
        .teardown = true,
    });
    @set_local_color_config(broadcast_color, .{
        .routes = .{},
        .teardown = true,
    });
}
