param root_2nd_phase: i16;

param X_1st_RD_0: comptime_struct;
param X_1st_RD_1: comptime_struct;
param Y_1st_RD_0: comptime_struct;
param Y_1st_RD_1: comptime_struct;

param X_2nd_RD_0: comptime_struct;
param X_2nd_RD_1: comptime_struct;
param Y_2nd_RD_0: comptime_struct;
param Y_2nd_RD_1: comptime_struct;

param X_BD: comptime_struct;
param Y_BD: comptime_struct;

param reduce_1st_color_0: color;
param reduce_1st_color_1: color;

param reduce_2nd_color_0: color;
param reduce_2nd_color_1: color;

param broadcast_color: color;

const trace = @import_module(
  "<debug>",
  .{ .key = "debug_comm",
     .buffer_size = 100,
   }
);
const simprint = @import_module("<simprint>");

const reduce_1st_0_recv_queue_id = @get_input_queue(3);
const reduce_1st_0_send_queue_id = @get_output_queue(3);
const reduce_1st_1_recv_queue_id = @get_input_queue(4);
const reduce_1st_1_send_queue_id = @get_output_queue(4);

const reduce_2nd_0_recv_queue_id = @get_input_queue(5);
const reduce_2nd_0_send_queue_id = @get_output_queue(5);
const reduce_2nd_1_recv_queue_id = @get_input_queue(6);
const reduce_2nd_1_send_queue_id = @get_output_queue(6);

const broadcast_recv_queue_id = @get_input_queue(7);
const broadcast_send_queue_id = @get_output_queue(7);

const ctrl = @import_module("<control>");
const tile_config = @import_module("<tile_config>");
const color_config = tile_config.color_config;
const timestamp = @import_module("<time>");

const dummy = @zeros([1]f16);
const two32_f32: f32 = 4294967296.0;

const comm_phase_count: i16 = 9;
const comm_subphase_count: i16 = comm_phase_count * 2;

var comm_subphase_cycles_f32 = @zeros([comm_subphase_count]f32);
var ptr_comm_subphase_cycles: [*]f32 = &comm_subphase_cycles_f32;

var comm_tsc_start_buf = @zeros([timestamp.tsc_size_words]u16);
var comm_tsc_end_buf = @zeros([timestamp.tsc_size_words]u16);

fn reset_comm_subphase_cycles() void {
    for (@range(i16, comm_subphase_count)) |i| {
        comm_subphase_cycles_f32[i] = 0.0;
    }
}

fn comm_reduce_idx(comm_phase_id: i16) i16 {
    return comm_phase_id * 2;
}

fn comm_broadcast_idx(comm_phase_id: i16) i16 {
    return comm_phase_id * 2 + 1;
}

fn comm_subphase_start(profile_enabled: i16) void {
    if (profile_enabled != 0) {
        timestamp.get_timestamp(&comm_tsc_start_buf);
    }
}

fn comm_subphase_stop(comm_subphase_id: i16, profile_enabled: i16) void {
    if (profile_enabled != 0) {
        var start_lo: u32 = 0;
        var end_lo: u32 = 0;
        var delta_lo_f32: f32 = 0.0;
        var delta_hi_f32: f32 = 0.0;

        timestamp.get_timestamp(&comm_tsc_end_buf);

        start_lo = (@as(u32, comm_tsc_start_buf[1]) << @as(u16, 16)) | @as(u32, comm_tsc_start_buf[0]);
        end_lo = (@as(u32, comm_tsc_end_buf[1]) << @as(u16, 16)) | @as(u32, comm_tsc_end_buf[0]);
        delta_hi_f32 = @as(f32, comm_tsc_end_buf[2] - comm_tsc_start_buf[2]);

        if (end_lo >= start_lo) {
            delta_lo_f32 = @as(f32, end_lo - start_lo);
        } else {
            delta_lo_f32 = two32_f32 - @as(f32, start_lo) + @as(f32, end_lo);
            delta_hi_f32 -= 1.0;
        }

        comm_subphase_cycles_f32[comm_subphase_id] += delta_hi_f32 * two32_f32 + delta_lo_f32;
    }
}

