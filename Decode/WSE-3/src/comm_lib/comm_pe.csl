    } else if (pe_id > root_2nd_phase) {
        if (remainder_pe_id == root_1st_phase) {
            if (pe_id > P - pe_num_p_group - 1) {
                if (quotient_pe_id % 2 == 0) {
                    @fmovh(reduce_2nd_0_send_bsz_dim_QKV_fusion, vector_buf_dsr);
                } else {
