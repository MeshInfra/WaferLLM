const teardown = tile_config.teardown;

fn is_in_teardown(color_name: color) bool {
  const base_addr = @as(tile_config.reg_type, tile_config.addresses.COLOR_CONFIG) / tile_config.word_size;
  const color_id = @get_int(color_name);
  const color_addr = base_addr + color_id;
  var state = @get_config(color_addr, tile_config.target.color_addr_range);
  const mask = 1 << tile_config.target.teardown_in_progress_offset;
  return @as(bool, state & mask);
}

fn teardown_exit(color_name: color) void {
  const base_addr = @as(tile_config.reg_type, tile_config.addresses.COLOR_CONFIG) / tile_config.word_size;
  const color_id = @get_int(color_name);
  const color_addr = base_addr + color_id;
  var state = @get_config(color_addr, tile_config.target.color_addr_range);
  const mask = 1 << tile_config.target.teardown_in_progress_offset;
  const is_in_td = @as(bool, state & mask);
  if (is_in_td) {
    teardown.exit(color_name);
  }
}

